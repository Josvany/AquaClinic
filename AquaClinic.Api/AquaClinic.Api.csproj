<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AquaClinic.Application\AquaClinic.Application.csproj" />
    <ProjectReference Include="..\AquaClinic.Identity\AquaClinic.Identity.csproj" />
