@page "/consultas"
@attribute [Authorize]
@rendermode InteractiveServer

<h3 class="mb-5">@TextoUi.T("Consultas del mes")</h3>

<div class="row">
    <div class="col-2">
        <span>@TextoUi.T("Seleccione el mes")</span>
        <select class="form-select" @bind="@SelectedMonth">
            <option value=""></option>
            @foreach (var month in MonthList)
            {
                <option value="@month"> @month </option>
            }
        </select>
    </div>
    <div class="col-2">
        <span>@TextoUi.T("Seleccione el año")</span>
        <select class="form-select" @bind="@SelectedYear">
            <option value=""></option>
            @foreach (var year in YearList)
            {
                <option value="@year"> @year</option>
            }
        </select>
    </div>
</div>


<button @onclick="GetConsultas" class="mt-4">@TextoUi.T("Consultar")</button>

<br />

@if (consultasList == null)
{
    <p><em>@TextoUi.T("Sin datos")</em></p>
}
else
{
    <table class="ticket-sales-table">
        <thead>
            <tr>
                <th>@TextoUi.T("Fecha")</th>
                <th>@TextoUi.T("Total")</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in consultasList)
            {
                <tr>
                    <td>@order.FechaSolicitada.ToString("d", System.Globalization.CultureInfo.CurrentCulture)</td>
                    <td>@order.TotalConsulta</td>
                </tr>
            }
        </tbody>
    </table>

    <Pager PageIndex="@paginatedList.PageIndex" TotalPages=@paginatedList.TotalPages OnClick="PageIndexChanged"
           HasNextPage=@paginatedList.HasNextPage HasPreviousPage=@paginatedList.HasPreviousPage>
    </Pager>
}
