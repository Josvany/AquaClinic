@page "/consultas"
@attribute [Authorize]
@rendermode InteractiveServer

<h3 class="mb-5">Consultas del mes</h3>

<div class="row">
    <div class="col-2">
        <span>Seleccione el mes</span>
        <select class="form-select" @bind="@SelectedMonth">
            <option value=""></option>
            @foreach (var month in MonthList)
            {
                <option value="@month"> @month </option>
            }
        </select>
    </div>
    <div class="col-2">
        <span>Seleccione el año</span>
        <select class="form-select" @bind="@SelectedYear">
            <option value=""></option>
            @foreach (var year in YearList)
            {
                <option value="@year"> @year</option>
            }
        </select>
    </div>
</div>


<button @onclick="GetConsultas" class="mt-4">Consultar</button>

<br />

@if (consultasList == null)
{
    <p><em>Sin datos</em></p>
}
else
{
    <table class="ticket-sales-table">
        <thead>
            <tr>
                <th>Fecha</th>
                <th>Total</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in consultasList)
            {
                <tr>
                    <td>@order.FechaSolicitada</td>
                    <td>@order.TotalConsulta</td>
                </tr>
            }
        </tbody>
    </table>

    <Pager PageIndex="@paginatedList.PageIndex" TotalPages=@paginatedList.TotalPages OnClick="PageIndexChanged"
           HasNextPage=@paginatedList.HasNextPage HasPreviousPage=@paginatedList.HasPreviousPage>
    </Pager>
}
