@page "/register"

<PageTitle>Registro</PageTitle>

<div class="ag-auth">
    <div class="ag-auth-card">
        <span class="ag-saludo">Crea tu cuenta</span>
        <h1>Registrarse</h1>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="alert alert-danger mt-3">@ErrorMessage</div>
        }

        <!-- Formulario HTML estandar: POST a /auth/register (minimal API). -->
        <form method="post" action="/auth/register" class="mt-3">
            <AntiforgeryToken />
            <div class="ag-field">
                <label for="email">Correo</label>
                <input type="email" id="email" name="email" class="form-control login-field"
                       required placeholder="tu@correo.com" />
            </div>
            <div class="ag-field">
                <label for="password">Contrase&#241;a</label>
                <input type="password" id="password" name="password" class="form-control login-field"
                       required minlength="8" placeholder="M&#237;nimo 8 caracteres" />
            </div>
            <button class="ag-btn ag-auth-submit" type="submit">Registrarse</button>
        </form>

        <p class="mt-3 mb-0">
            <a href="/login">&#191;Ya tienes cuenta? Inicia sesi&#243;n</a>
        </p>
    </div>
</div>
