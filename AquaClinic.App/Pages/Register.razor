@page "/register"

<PageTitle>@TextoUi.T("Registro")</PageTitle>

<div class="ag-auth">
    <div class="ag-auth-card">
        <span class="ag-saludo">@TextoUi.T("Crea tu cuenta")</span>
        <h1>@TextoUi.T("Registrarse")</h1>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="alert alert-danger mt-3">@TextoUi.T(ErrorMessage)</div>
        }

        <!-- Formulario HTML estandar: POST a /auth/register (minimal API). -->
        <form method="post" action="/auth/register" class="mt-3">
            <AntiforgeryToken />
            <div class="ag-field">
                <label for="email">@TextoUi.T("Correo")</label>
                <input type="email" id="email" name="email" class="form-control login-field"
                       required placeholder="@TextoUi.T("tu@correo.com")" />
            </div>
            <div class="ag-field">
                <label for="password">@TextoUi.T("Contraseña")</label>
                <input type="password" id="password" name="password" class="form-control login-field"
                       required minlength="8" placeholder="@TextoUi.T("Mínimo 8 caracteres")" />
            </div>
            <div class="ag-field" style="flex-direction:row; align-items:flex-start; gap:8px;">
                <input type="checkbox" id="consentimiento" name="consentimiento" value="si" required style="margin-top:4px;" />
                <label for="consentimiento" style="font-size:0.85rem; line-height:1.4;">
                    @TextoUi.T("Acepto recibir comunicaciones promocionales por correo electrónico.")
                </label>
            </div>
            <button class="ag-btn ag-auth-submit" type="submit">@TextoUi.T("Registrarse")</button>
        </form>

        <p class="mt-3 mb-0">
            <a href="/login">@TextoUi.T("¿Ya tienes cuenta? Inicia sesión")</a>
        </p>
    </div>
</div>
