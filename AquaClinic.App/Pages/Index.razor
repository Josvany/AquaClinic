@page "/"
@inject IServiciosPublicosDataService Reservas

<HeadContent>
    <meta name="description" content="Clínica de estética facial en Langley, BC. Análisis digital de la piel y tratamientos faciales, avanzados, inyectables y de cejas aplicados por profesionales certificados." />
    <meta property="og:title" content="Aqua Skin & Glow Clinic | Tu piel, leída con ciencia" />
    <meta property="og:description" content="Agenda tu análisis de piel y elige el tratamiento sobre la agenda real de la clínica." />
    <meta property="og:type" content="website" />
</HeadContent>

<PageTitle>@TextoUi.T("Aqua Skin & Glow Clinic | Estética facial en Langley, BC")</PageTitle>

@* Portada: la lámina de fotos ocupa la pantalla entera y va cambiando
   sola. El titular va en blanco sobre el velo teal, como en la plana. *@
<section class="ag-portada" aria-labelledby="ag-portada-titular">
    <div class="ag-portada-fondo" aria-hidden="true">
        <span class="ag-lamina ag-lamina-1"></span>
        <span class="ag-lamina ag-lamina-2"></span>
        <span class="ag-lamina ag-lamina-3"></span>
        <span class="ag-lamina ag-lamina-4"></span>
        <span class="ag-lamina ag-lamina-5"></span>
    </div>
    <div class="ag-portada-velo" aria-hidden="true"></div>

    <div class="ag-portada-contenido">
        <p class="ag-portada-antetitulo">@TextoUi.T("Aqua Skin & Glow Clinic · Langley, BC")</p>
        <h1 class="ag-portada-titular" id="ag-portada-titular">@((MarkupString)TextoUi.T("Tu piel, leída con ciencia y tratada con <em>calma</em>"))</h1>
        <p class="ag-portada-intro">
            @TextoUi.T("Diagnóstico facial con análisis digital, tratamientos aplicados por profesionales certificados y un plan de cuidado que se adapta a tu piel, no al revés.")
        </p>
        <a class="ag-portada-boton" href="/reservar">@TextoUi.T("Agenda tu análisis de piel")</a>
    </div>

    <a class="ag-portada-bajada" href="#tratamientos">
        <span>@TextoUi.T("Ver tratamientos")</span>
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor"
             stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 4v15" />
            <path d="M6 13l6 6 6-6" />
        </svg>
    </a>
</section>

@* Mosaico de tratamientos: cada familia es una foto con el rótulo encima
   y baja al catálogo real. *@
<section class="ag-mosaico-seccion" id="tratamientos" aria-labelledby="ag-mosaico-titular">
    <div class="ag-seccion-cabecera" data-ag-reveal>
        <h2 id="ag-mosaico-titular">@TextoUi.T("Cuatro tratamientos, una misma piel")</h2>
        <p class="ag-cota">@TextoUi.T("faciales · avanzado · inyectables · cejas")</p>
    </div>

    <div class="ag-mosaico">
        <a class="ag-mosaico-pieza" href="#servicios" data-ag-reveal>
            <img src="/img/serv-faciales.jpg" alt="@TextoUi.T("Limpieza facial en cabina")" width="1200" height="800" loading="lazy" decoding="async" />
            <span class="ag-mosaico-velo" aria-hidden="true"></span>
            <span class="ag-mosaico-texto">
                <span class="ag-mosaico-titular">@TextoUi.T("Faciales")</span>
                <span class="ag-mosaico-detalle">@TextoUi.T("limpieza · hidratación · glow")</span>
            </span>
        </a>
        <a class="ag-mosaico-pieza" href="#servicios" data-ag-reveal>
            <img src="/img/serv-avanzado.jpg" alt="@TextoUi.T("Tratamiento facial con cabezal ultrasónico")" width="1200" height="800" loading="lazy" decoding="async" />
            <span class="ag-mosaico-velo" aria-hidden="true"></span>
            <span class="ag-mosaico-texto">
                <span class="ag-mosaico-titular">@TextoUi.T("Cuidado avanzado")</span>
                <span class="ag-mosaico-detalle">@TextoUi.T("radiofrecuencia · protocolos")</span>
            </span>
        </a>
        <a class="ag-mosaico-pieza" href="#servicios" data-ag-reveal>
            <img src="/img/serv-inyectables.jpg" alt="@TextoUi.T("Aplicación de tratamiento inyectable en el rostro")" width="1200" height="800" loading="lazy" decoding="async" />
            <span class="ag-mosaico-velo" aria-hidden="true"></span>
            <span class="ag-mosaico-texto">
                <span class="ag-mosaico-titular">@TextoUi.T("Inyectables")</span>
                <span class="ag-mosaico-detalle">@TextoUi.T("toxina · rellenos · mesoterapia")</span>
            </span>
        </a>
        <a class="ag-mosaico-pieza" href="#servicios" data-ag-reveal>
            <img src="/img/serv-cejas.jpg" alt="@TextoUi.T("Perfilado de cejas con la especialista")" width="1200" height="800" loading="lazy" decoding="async" />
            <span class="ag-mosaico-velo" aria-hidden="true"></span>
            <span class="ag-mosaico-texto">
                <span class="ag-mosaico-titular">@TextoUi.T("Cejas")</span>
                <span class="ag-mosaico-detalle">@TextoUi.T("perfilado · laminado · tinte")</span>
            </span>
        </a>
    </div>
</section>

@* Catálogo real de la clínica, agrupado por especialidad. El pie y la
   navegación enlazan aquí con /#servicios. *@
<section id="servicios" class="ag-section">
    <div class="ag-contenedor">
        <div class="ag-seccion-intro" data-ag-reveal>
            <div>
                <span class="ag-label-caps" style="display:block; margin-bottom: 10px;">@TextoUi.T("Nuestros tratamientos")</span>
                <h2 class="ag-seccion-titulo">@TextoUi.T("Elige por dónde empezar")</h2>
            </div>
            <p>@TextoUi.T("Cada plan comienza con el análisis digital de tu piel. A partir de ahí elegimos juntos el tratamiento correcto, en el orden correcto.")</p>
        </div>

        <div class="ag-servicios-lista">
            @foreach (var grupo in _serviciosPorEspecialidad)
            {
                <div class="ag-banner-grupo" data-ag-reveal-escalon>
                    <h3 class="ag-banner-especialidad">@TextoUi.T(grupo.Key)</h3>
                    <div class="ag-banner-grid">
                        @foreach (var servicio in grupo)
                        {
                            <a class="ag-banner-servicio" href="/reservar?servicio=@servicio.ServicioId">
                                <h3>@TextoUi.T(servicio.Nombre)</h3>
                                @if (!string.IsNullOrWhiteSpace(servicio.Descripcion))
                                {
                                    <p>@TextoUi.T(servicio.Descripcion)</p>
                                }
                                @if (servicio.TienePromocion)
                                {
                                    <span class="ag-banner-descuento" title="@servicio.NombrePromocion">
                                        @servicio.DescuentoTexto
                                    </span>
                                    <span class="ag-banner-tarifa">
                                        <s class="ag-banner-precio-antes">@servicio.Precio.ToString("C", FormatoClinica.CulturaDinero)</s>
                                        <strong>@servicio.PrecioConDescuento.ToString("C", FormatoClinica.CulturaDinero)</strong>
                                        &middot; @servicio.DuracionMinutos min
                                    </span>
                                }
                                else
                                {
                                    <span class="ag-banner-tarifa">@servicio.Precio.ToString("C", FormatoClinica.CulturaDinero) &middot; @servicio.DuracionMinutos min</span>
                                }
                            </a>
                        }
                    </div>
                </div>
            }

            @if (!_serviciosPorEspecialidad.Any())
            {
                <div class="ag-panel">
                    <p style="margin:0; color:var(--ag-texto-mudo);">
                        @TextoUi.T("El catálogo no está disponible en este momento. Intenta de nuevo en unos minutos o escríbenos por WhatsApp para agendar.")
                    </p>
                </div>
            }
        </div>
    </div>
</section>

@* Banda editorial: la foto a un lado y la promesa al otro. *@
<section class="ag-editorial-banda">
    <figure class="ag-editorial-foto" data-ag-reveal>
        <img src="/img/editorial-clinica.jpg" alt="@TextoUi.T("Clienta revisando su piel frente al espejo junto a la especialista")" width="1600" height="1067" loading="lazy" decoding="async" />
    </figure>
    <div class="ag-editorial-texto" data-ag-reveal>
        <span class="ag-label-caps">@TextoUi.T("Cómo funciona")</span>
        <h2>@TextoUi.T("Elige el tratamiento. Nosotras nos encargamos del resto.")</h2>
        <p>
            @TextoUi.T("El análisis digital define tu protocolo y tú solo eliges el día. Te confirmamos por WhatsApp y te recordamos antes de tu cita, sin llamadas ni anticipos.")
        </p>
        <a class="ag-btn ag-editorial-boton" href="/reservar">@TextoUi.T("Encuentra un horario")</a>
    </div>
</section>

@* Franja de resultados recientes. *@
<section class="ag-obras-seccion" aria-labelledby="ag-obras-titular">
    <div class="ag-seccion-cabecera" data-ag-reveal>
        <h2 id="ag-obras-titular">@TextoUi.T("Resultados recientes")</h2>
        <p class="ag-cota">@TextoUi.T("cejas · hidratación · radiofrecuencia")</p>
    </div>

    <div class="ag-obras-franja" data-ag-reveal-escalon>
        <figure class="ag-obra">
            <img src="/img/obra-cejas.jpg" alt="@TextoUi.T("Diseño y perfilado de cejas")" width="1200" height="900" loading="lazy" decoding="async" />
            <figcaption>@TextoUi.T("Cejas")</figcaption>
        </figure>
        <figure class="ag-obra">
            <img src="/img/obra-hidro.jpg" alt="@TextoUi.T("Cabina con equipo de hidratación facial")" width="1200" height="900" loading="lazy" decoding="async" />
            <figcaption>@TextoUi.T("Hidratación")</figcaption>
        </figure>
        <figure class="ag-obra">
            <img src="/img/obra-radiofrecuencia.jpg" alt="@TextoUi.T("Aplicación de radiofrecuencia sobre la piel")" width="1200" height="900" loading="lazy" decoding="async" />
            <figcaption>@TextoUi.T("Radiofrecuencia")</figcaption>
        </figure>
    </div>

    <p class="ag-obras-pie"><a class="ag-text-link" href="#servicios">@TextoUi.T("Ver todos los tratamientos")</a></p>
</section>

<section class="ag-cta-final" data-ag-reveal>
    <div class="ag-contenedor">
        <span class="ag-label-caps" style="display:block; margin-bottom: 10px;">@TextoUi.T("Reserva en minutos")</span>
        <h2>@TextoUi.T("Empieza por conocer tu piel")</h2>
        <a class="ag-btn" href="/reservar">@TextoUi.T("Reservar cita ahora")</a>
        <p>@TextoUi.T("O escríbenos por WhatsApp si prefieres hablar con una persona.")</p>
    </div>
</section>

@code {
    /// <summary>Catalogo real de la API, agrupado por especialidad (vacio si la API no responde).</summary>
    private List<IGrouping<string, ServicioPublicoVm>> _serviciosPorEspecialidad = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var servicios = await Reservas.ObtenerServiciosAsync();

            _serviciosPorEspecialidad = servicios
                .GroupBy(s => s.EspecialidadNombre ?? "Otros servicios")
                .OrderBy(g => g.Key)
                .ToList();
        }
        catch
        {
            // Sin API: la portada muestra el aviso de catalogo no disponible
        }
    }
}
