@page "/"
@rendermode InteractiveServer

<PageTitle>AquaClinic</PageTitle>

<h1 class="page-title">&#161;Bienvenido al sistema de gesti&#243;n de AquaClinic!</h1>
<br />
<h4>Con esta aplicaci&#243;n tiene acceso a todas las funcionalidades de AquaClinic.</h4>

<br />

<AuthorizeView>
    <Authorized>
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">
                    <span class="oi oi-person" aria-hidden="true"></span>
                    Hola, @context.User.Identity?.Name
                </h5>
            </div>
            <div class="card-body">
                <div class="row mb-2">
                    <div class="col-md-3 fw-bold">Correo:</div>
                    <div class="col-md-9">@context.User.Identity?.Name</div>
                </div>
                @if (context.User.Claims.FirstOrDefault(c => c.Type == "nombre")?.Value is string nombre && !string.IsNullOrEmpty(nombre))
                {
                    <div class="row mb-2">
                        <div class="col-md-3 fw-bold">Nombre:</div>
                        <div class="col-md-9">@nombre</div>
                    </div>
                }
                <div class="row mb-2">
                    <div class="col-md-3 fw-bold">Roles:</div>
                    <div class="col-md-9">
                        @foreach (var rol in context.User.FindAll(System.Security.Claims.ClaimTypes.Role))
                        {
                            <span class="badge bg-info me-1">@rol.Value</span>
                        }
                    </div>
                </div>
                <br />
                <a href="/perfil" class="btn btn-outline-primary btn-sm me-2">
                    <span class="oi oi-person" aria-hidden="true"></span> Ver perfil completo
                </a>
                <form method="post" action="logout" class="d-inline">
                    <AntiforgeryToken />
                    <button type="submit" class="btn btn-outline-danger btn-sm">Cerrar sesi&#243;n</button>
                </form>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <p>Para acceder a todas las funcionalidades, inicia sesi&#243;n o reg&#237;strate:</p>
        <button @onclick="NavigateToLogin" class="btn btn-primary me-2">Iniciar sesi&#243;n</button>
        <button @onclick="NavigateToRegister" class="btn btn-outline-primary">Registrarse</button>
    </NotAuthorized>
</AuthorizeView>
