@page "/"
@inject IServiciosPublicosDataService Reservas

<PageTitle>Aqua Skin & Glow Clinic</PageTitle>

<section class="ag-hero">
    <div class="ag-hero-grid">
        <div>
            <span class="ag-label-caps" style="display:block; margin-bottom: 14px;">Aqua Skin &amp; Glow Clinic &middot; Langley, BC</span>
            <h1>Tu piel, le&iacute;da con ciencia y tratada con <em>calma</em></h1>
            <p class="ag-hero-lead">
                Diagn&oacute;stico facial con an&aacute;lisis digital, tratamientos aplicados por profesionales
                certificados y un plan de cuidado que se adapta a tu piel, no al rev&eacute;s.
            </p>
            <div class="ag-acciones">
                <a class="ag-btn" href="/reservar">Agenda tu an&aacute;lisis de piel</a>
                <a class="ag-btn ag-btn-contorno" href="#servicios">Ver tratamientos</a>
            </div>
        </div>
        <div class="ag-hero-media" aria-hidden="true">Fotograf&iacute;a del consultorio</div>
    </div>
    <div class="ag-ola" aria-hidden="true"></div>
</section>

<section id="servicios" class="ag-section">
    <div class="ag-contenedor">
        <div class="ag-seccion-intro" data-ag-reveal>
            <div>
                <span class="ag-label-caps" style="display:block; margin-bottom: 10px;">Nuestros tratamientos</span>
                <h2 class="ag-seccion-titulo">Cuatro tratamientos, una misma piel</h2>
            </div>
            <p>Cada plan comienza con el an&aacute;lisis digital de tu piel. A partir de ah&iacute; elegimos juntos el
               tratamiento correcto, en el orden correcto.</p>
        </div>

        <div class="ag-servicios-lista">
            @foreach (var grupo in _serviciosPorEspecialidad)
            {
                <div class="ag-banner-grupo" data-ag-reveal-escalon>
                    <h3 class="ag-banner-especialidad">@grupo.Key</h3>
                    <div class="ag-banner-grid">
                        @foreach (var servicio in grupo)
                        {
                            <a class="ag-banner-servicio" href="/reservar?servicio=@servicio.ServicioId">
                                <span class="ag-banner-marca" aria-hidden="true">@PalabraMarca(servicio.Nombre)</span>
                                <h3>@servicio.Nombre</h3>
                                @if (!string.IsNullOrWhiteSpace(servicio.Descripcion))
                                {
                                    <p>@servicio.Descripcion</p>
                                }
                                <span class="ag-banner-tarifa">@servicio.Precio.ToString("C", CulturaCad) &middot; @servicio.DuracionMinutos min</span>
                            </a>
                        }
                    </div>
                </div>
            }

            @if (!_serviciosPorEspecialidad.Any())
            {
                <div class="ag-panel">
                    <p style="margin:0; color:var(--ag-texto-mudo);">
                        El cat&aacute;logo no est&aacute; disponible en este momento. Intenta de nuevo en unos minutos
                        o escr&iacute;benos por WhatsApp para agendar.
                    </p>
                </div>
            }
        </div>
    </div>
</section>

<section class="ag-banda" data-ag-reveal>
    <div class="ag-banda-grid">
        <div><strong data-cuenta="2400">2400</strong><span>an&aacute;lisis de piel realizados</span></div>
        <div><strong data-cuenta="97">97</strong><span>% de pacientes que repiten</span></div>
        <div><strong data-cuenta="14">14</strong><span>a&ntilde;os de experiencia</span></div>
    </div>
</section>

<section class="ag-section">
    <div class="ag-contenedor">
        <div class="ag-seccion-intro" style="margin-bottom:0;" data-ag-reveal>
            <div>
                <span class="ag-label-caps" style="display:block; margin-bottom: 10px;">Testimonios reales</span>
                <h2 class="ag-seccion-titulo" style="margin-bottom: 48px;">Lo que dicen quienes ya vinieron</h2>
            </div>
        </div>
        <div class="ag-testimonios-grid" data-ag-reveal-escalon>
            <figure class="ag-testimonio">
                <p>&ldquo;El an&aacute;lisis me mostr&oacute; cosas que ning&uacute;n espejo me hab&iacute;a
                   ense&ntilde;ado. El tratamiento facial fue distinto a todo lo que hab&iacute;a probado.&rdquo;</p>
                <footer>Mariana R. &mdash; tratamiento facial mensual</footer>
            </figure>
            <figure class="ag-testimonio">
                <p>&ldquo;Me daba miedo la toxina botul&iacute;nica. Aplicaron tan poco y tan bien que nadie not&oacute;
                   nada&hellip; excepto que me ve&iacute;a descansada.&rdquo;</p>
                <footer>Carla V. &mdash; inyectables</footer>
            </figure>
            <figure class="ag-testimonio">
                <p>&ldquo;Reserv&eacute; desde el celular en dos minutos, me recordaron por WhatsApp y llegu&eacute;
                   sin esperar. As&iacute; deber&iacute;a ser siempre.&rdquo;</p>
                <footer>Luc&iacute;a M. &mdash; cuidado avanzado de la piel</footer>
            </figure>
        </div>
    </div>
</section>

<section class="ag-cta-final" data-ag-reveal>
    <div class="ag-contenedor">
        <span class="ag-label-caps" style="display:block; margin-bottom: 10px;">Reserva en minutos</span>
        <h2>Empieza por conocer tu piel</h2>
        <a class="ag-btn" href="/reservar">Reservar cita ahora</a>
        <p>O escr&iacute;benos por WhatsApp si prefieres hablar con una persona.</p>
    </div>
</section>

@code {
    private System.Globalization.CultureInfo CulturaCad =
        System.Globalization.CultureInfo.GetCultureInfo("en-CA");

    /// <summary>Catalogo real de la API, agrupado por especialidad (vacio si la API no responde).</summary>
    private List<IGrouping<string, ServicioPublicoVm>> _serviciosPorEspecialidad = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var servicios = await Reservas.ObtenerServiciosAsync();

            _serviciosPorEspecialidad = servicios
                .GroupBy(s => s.EspecialidadNombre ?? "Otros servicios")
                .OrderBy(g => g.Key)
                .ToList();
        }
        catch
        {
            // Sin API: la portada muestra el aviso de catalogo no disponible
        }
    }

    /// <summary>
    /// Palabra script de la marca de agua del banner. Derivada del nombre del
    /// servicio (1-2 palabras); si no hay nombre queda la inicial.
    /// </summary>
    private static string PalabraMarca(string nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre)) return "aqua";

        var partes = nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return partes.Length >= 2 ? $"{partes[0]} {partes[1]}".ToLowerInvariant() : partes[0].ToLowerInvariant();
    }
}
