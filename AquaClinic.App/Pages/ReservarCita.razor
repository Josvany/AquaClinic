@page "/reservar"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject AgendaRealtimeService Agenda
@inject IUsuarioDataService Usuarios
@inject NavigationManager Navigation
@inject NotificadorUi Notificador

<PageTitle>@TextoUi.T("Reservar cita") — Aqua Skin & Glow</PageTitle>

<section class="ag-section ag-reserva-seccion">
    <div class="ag-reserva-contenedor">
        <div class="ag-seccion-intro">
            <div>
                <span class="ag-label-caps" style="display:block; margin-bottom: 10px;">@TextoUi.T("Agenda tu visita")</span>
                <h2 class="ag-seccion-titulo">@TextoUi.T("Reserva tu cita")</h2>
            </div>
            <div class="ag-reserva-intro-derecha">
                <p>@TextoUi.T("Haz clic en un horario libre para reservar; se actualiza en tiempo real.")</p>
                <p class="ag-reserva-leyenda">
                    <span class="ag-leyenda ag-leyenda-ocupado"></span> @TextoUi.T("Ocupado")
                    &nbsp;&nbsp;
                    <span class="ag-leyenda ag-leyenda-reservando"></span> @TextoUi.T("Reservando")
                </p>
            </div>
        </div>

        <div class="ag-booking-card ag-booking-scheduler">
            @if (_errorCarga is not null)
            {
                <div class="alert alert-warning">@TextoUi.T(_errorCarga)</div>
            }
            else
            {
                @if (_esMovil)
                {
                    <RadzenScheduler @ref="_scheduler" TItem="OcupacionAgenda" Data="@_ocupaciones"
                                     TextProperty="Estado" StartProperty="Inicio" EndProperty="Fin"
                                     Date="@_fecha" DateChange="@(OnFechaCambioAsync)" Style="height: 72vh; min-height: 420px;"
                                     SlotSelect="@(OnSlotSelectAsync)"
                                     AppointmentSelect="@(OnCitaSelectAsync)"
                                     AppointmentRender="@(OnAppointmentRender)"
                                     SlotRender="@(OnSlotRender)"
                                     AppointmentMouseEnter="@(AlMouseEnCita)"
                                     AppointmentMouseLeave="@(AlMouseFueraCita)">
                        <RadzenDayView StartTime="@TimeSpan.FromHours(8)" EndTime="@TimeSpan.FromHours(19)" MinutesPerSlot="15" />
                    </RadzenScheduler>
                }
                else
                {
                    <RadzenScheduler @ref="_scheduler" TItem="OcupacionAgenda" Data="@_ocupaciones"
                                     TextProperty="Estado" StartProperty="Inicio" EndProperty="Fin"
                                     Date="@_fecha" DateChange="@(OnFechaCambioAsync)" Style="height: 78vh; min-height: 560px;"
                                     SlotSelect="@(OnSlotSelectAsync)"
                                     AppointmentSelect="@(OnCitaSelectAsync)"
                                     AppointmentRender="@(OnAppointmentRender)"
                                     SlotRender="@(OnSlotRender)"
                                     AppointmentMouseEnter="@(AlMouseEnCita)"
                                     AppointmentMouseLeave="@(AlMouseFueraCita)">
                        <RadzenWeekView StartTime="@TimeSpan.FromHours(8)" EndTime="@TimeSpan.FromHours(19)" MinutesPerSlot="15" />
                        <RadzenDayView StartTime="@TimeSpan.FromHours(8)" EndTime="@TimeSpan.FromHours(19)" MinutesPerSlot="15" />
                    </RadzenScheduler>
                }
            }
        </div>

        <div class="ag-reserva-nota">
            <h3>@TextoUi.T("Antes de tu visita")</h3>
            <p>
                @TextoUi.T("No necesitas crear una cuenta: con tu nombre y correo basta para agendar. Si el tratamiento lo requiere, la valoración previa va incluida en tu primera cita.")
            </p>
        </div>
    </div>
</section>
