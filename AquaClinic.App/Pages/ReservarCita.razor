@page "/reservar"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject AgendaRealtimeService Agenda
@inject IUsuarioDataService Usuarios
@inject NavigationManager Navigation
@inject NotificadorUi Notificador

<PageTitle>Reservar cita — Aqua Skin & Glow</PageTitle>

<section class="ag-section ag-reserva-seccion">
    <div class="ag-reserva-contenedor">
        <div class="ag-seccion-intro">
            <div>
                <span class="ag-label-caps" style="display:block; margin-bottom: 10px;">Agenda tu visita</span>
                <h2 class="ag-seccion-titulo">Reserva tu cita</h2>
            </div>
            <div class="ag-reserva-intro-derecha">
                <p>Haz clic en un horario libre para reservar; se actualiza en tiempo real.</p>
                <p class="ag-reserva-leyenda">
                    <span class="ag-leyenda ag-leyenda-ocupado"></span> Ocupado
                    &nbsp;&nbsp;
                    <span class="ag-leyenda ag-leyenda-reservando"></span> Reservando
                </p>
            </div>
        </div>

        <div class="ag-booking-card ag-booking-scheduler">
            @if (_errorCarga is not null)
            {
                <div class="alert alert-warning">@_errorCarga</div>
            }
            else
            {

                <RadzenScheduler @ref="_scheduler" TItem="OcupacionAgenda" Data="@_ocupaciones"
                                 TextProperty="Estado" StartProperty="Inicio" EndProperty="Fin"
                                 Date="@_fecha" Style="height: 78vh; min-height: 560px;"
                                 SlotSelect="@(OnSlotSelectAsync)"
                                 AppointmentRender="@(OnAppointmentRender)"
                                 AppointmentMouseEnter="@(AlMouseEnCita)"
                                 AppointmentMouseLeave="@(AlMouseFueraCita)">
                    <RadzenWeekView StartTime="@TimeSpan.FromHours(8)" EndTime="@TimeSpan.FromHours(19)" MinutesPerSlot="30" />
                    <RadzenDayView StartTime="@TimeSpan.FromHours(8)" EndTime="@TimeSpan.FromHours(19)" MinutesPerSlot="30" />
                </RadzenScheduler>
            }
        </div>

        <div class="ag-reserva-nota">
            <h3>Antes de tu visita</h3>
            <p>
                No necesitas crear una cuenta: con tu nombre y correo basta para agendar. Si el tratamiento
                lo requiere, la valoraci&oacute;n previa va incluida en tu primera cita.
            </p>
        </div>
    </div>
</section>
