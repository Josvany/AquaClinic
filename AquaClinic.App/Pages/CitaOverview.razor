@page "/citaoverview"
@rendermode InteractiveServer

<h3>Citas</h3>

<div class="m-2 d-flex justify-content-end">
    <button @onclick="AddNewCita" class="me-1">Nueva cita</button>
    <button @onclick="ExportCitas">Exportar citas</button>
</div>

@if (_errorCarga != null)
{
    <div class="alert alert-danger mt-3">@_errorCarga</div>
}
else if (Citas == null)
{
    <p><em>Cargando...</em></p>
}
else
{
    <h4 class="mt-4">Calendario de citas</h4>
    <RadzenScheduler TItem="AppointmentData" Data="_eventos"
                     TextProperty="Text" StartProperty="Start" EndProperty="End"
                     Date="_fecha" Style="height: 620px;">
        <RadzenMonthView />
        <RadzenWeekView />
        <RadzenDayView />
    </RadzenScheduler>

    @if (Citas.Count == 0)
    {
        <p class="mt-3"><em>No hay citas agendadas todav&iacute;a.</em></p>
    }

    <table>
        <thead>
            <tr>
                <th></th>
                <th>Nombre</th>
                <th>Fecha</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ev in Citas)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrEmpty(ev.ImagenUrl))
                        {
                            <img src="@(ev.ImagenUrl)" class="event-image" />
                        }
                    </td>
                    <td class="event-name">@ev.Nombre </td>
                    <td class="event-date">@ev.Fecha.ToShortDateString() </td>
                    <td>
                        <a href="@($"citadetails/{ev.CitaId}")" class="event-purchase-button btn">
                            <i class="fa-solid fa-pen-to-square"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (_errorExport != null)
{
    <div class="alert alert-warning mt-3">@_errorExport</div>
}
