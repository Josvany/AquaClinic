@page "/citaoverview"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IAsyncDisposable
@using AquaClinic.App.ViewModels
@using Radzen.Blazor

<section class="ag-citas-seccion">
    <div class="ag-contenedor ag-contenedor-ancho">
        <div class="ag-citas-encabezado">
            <div>
                <span class="ag-label-caps">@TextoUi.T("Agenda interna")</span>
                <h1 class="ag-citas-titulo">@TextoUi.T("Citas")</h1>
                <p class="ag-citas-subtitulo">
                    @TextoUi.T("Calendario de la clínica: las citas agendadas y, en dorado, los horarios que se están reservando en este momento.")
                </p>
            </div>

            <div class="ag-citas-acciones">
                <RadzenButton Text="@TextoUi.T("Nueva cita")" Icon="add_circle_outline"
                              ButtonStyle="ButtonStyle.Primary" Click="@AddNewCita" />
                <RadzenButton Text="@TextoUi.T("Exportar citas")" Icon="file_download"
                              ButtonStyle="ButtonStyle.Secondary" Click="@ExportCitas" />
            </div>
        </div>

        @if (_errorCarga is not null)
        {
            <div class="alert alert-danger">@TextoUi.T(_errorCarga)</div>
        }
        else
        {
            <div class="ag-panel ag-citas-calendario">
                <div class="ag-citas-barra">
                    <p class="ag-reserva-leyenda">
                        <span class="ag-leyenda ag-leyenda-ocupado"></span> @TextoUi.T("Cita agendada")
                        &nbsp;&nbsp;
                        <span class="ag-leyenda ag-leyenda-reservando"></span> @TextoUi.T("Reservando")
                        &nbsp;&nbsp;
                        <span class="ag-leyenda ag-leyenda-cerrado"></span> @TextoUi.T("Cerrado")
                    </p>

                    @if (HayReservasEnProceso)
                    {
                        <span class="ag-citas-enproceso ag-citas-enproceso-activo">
                            <i class="fa-solid fa-circle" aria-hidden="true"></i>
                            @TextoReservasEnProceso
                        </span>
                    }
                </div>

                <RadzenScheduler @ref="_scheduler" TItem="OcupacionAgenda" Data="@_eventos"
                                 TextProperty="Text" StartProperty="Inicio" EndProperty="Fin"
                                 Date="@_fecha" Style="height: 620px;"
                                 AppointmentRender="@(OnAppointmentRender)">
                    <RadzenMonthView />
                    <RadzenWeekView StartTime="@TimeSpan.FromHours(8)" EndTime="@TimeSpan.FromHours(19)" MinutesPerSlot="30" />
                    <RadzenDayView StartTime="@TimeSpan.FromHours(8)" EndTime="@TimeSpan.FromHours(19)" MinutesPerSlot="30" />
                </RadzenScheduler>
            </div>

            <div class="ag-citas-lista">
                <div class="ag-citas-lista-encabezado">
                    <h3>@TextoUi.T("Citas agendadas")</h3>
                    <span class="ag-label-caps">@_totalCitas @TextoUi.T("cita(s)")</span>
                </div>

                <RadzenDataGrid @ref="_grid" TItem="CitaListViewModel" Data="@_citas"
                                LoadData="@(CargarPaginaAsync)" Count="@_totalCitas"
                                AllowPaging="true" AllowFiltering="true" FilterMode="FilterMode.Advanced"
                                PageSize="10" PagerPageSizeOptions="@(false)" AllowSorting="false" Width="100%">
                    <Columns>
                        <RadzenDataGridColumn TItem="CitaListViewModel" Property="Nombre" Title="@TextoUi.T("Cliente")"
                                              FilterOperators="@(new FilterOperator[] { FilterOperator.Contains })" />
                        <RadzenDataGridColumn TItem="CitaListViewModel" Property="Fecha" Title="@TextoUi.T("Fecha")" Filterable="false">
                            <Template Context="cita">
                                <span class="event-date">@cita.Fecha.ToString("f", System.Globalization.CultureInfo.CurrentCulture)</span>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="CitaListViewModel" Property="Estado" Title="@TextoUi.T("Estado")" Width="150px"
                                              FilterOperator="FilterOperator.Equals"
                                              FilterOperators="@(new FilterOperator[] { FilterOperator.Equals })">
                            <Template Context="cita">
                                <span class="ag-miscitas-estado ag-miscitas-estado-@cita.Estado.ToLower()">@cita.Estado</span>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="CitaListViewModel" Sortable="false" Filterable="false" Width="90px" TextAlign="TextAlign.Center">
                            <Template Context="cita">
                                <a href="@($"citadetails/{cita.CitaId}")" class="event-purchase-button btn"
                                   title="@TextoUi.T("Editar cita")">
                                    <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
                                </a>
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </div>
        }

        @if (_errorExport is not null)
        {
            <div class="alert alert-warning mt-3">@TextoUi.T(_errorExport)</div>
        }
    </div>
</section>
