@page "/citaoverview"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IAsyncDisposable
@using AquaClinic.App.ViewModels
@using Radzen.Blazor

<section class="ag-citas-seccion">
    <div class="ag-contenedor ag-contenedor-ancho">
        <div class="ag-citas-encabezado">
            <div>
                <span class="ag-label-caps">Agenda interna</span>
                <h1 class="ag-citas-titulo">Citas</h1>
                <p class="ag-citas-subtitulo">
                    Calendario de la cl&iacute;nica: las citas agendadas y, en dorado, los horarios
                    que se est&aacute;n reservando en este momento.
                </p>
            </div>

            <div class="ag-citas-acciones">
                <RadzenButton Text="Nueva cita" Icon="add_circle_outline"
                              ButtonStyle="ButtonStyle.Primary" Click="@AddNewCita" />
                <RadzenButton Text="Exportar citas" Icon="file_download"
                              ButtonStyle="ButtonStyle.Secondary" Click="@ExportCitas" />
            </div>
        </div>

        @if (_errorCarga is not null)
        {
            <div class="alert alert-danger">@_errorCarga</div>
        }
        else
        {
            <div class="ag-panel ag-citas-calendario">
                <div class="ag-citas-barra">
                    <p class="ag-reserva-leyenda">
                        <span class="ag-leyenda ag-leyenda-ocupado"></span> Cita agendada
                        &nbsp;&nbsp;
                        <span class="ag-leyenda ag-leyenda-reservando"></span> Reservando
                    </p>

                    @if (HayReservasEnProceso)
                    {
                        <span class="ag-citas-enproceso ag-citas-enproceso-activo">
                            <i class="fa-solid fa-circle" aria-hidden="true"></i>
                            @TextoReservasEnProceso
                        </span>
                    }
                </div>

                <RadzenScheduler @ref="_scheduler" TItem="OcupacionAgenda" Data="@_eventos"
                                 TextProperty="Text" StartProperty="Inicio" EndProperty="Fin"
                                 Date="@_fecha" Style="height: 620px;"
                                 AppointmentRender="@(OnAppointmentRender)">
                    <RadzenMonthView />
                    <RadzenWeekView StartTime="@TimeSpan.FromHours(8)" EndTime="@TimeSpan.FromHours(19)" MinutesPerSlot="30" />
                    <RadzenDayView StartTime="@TimeSpan.FromHours(8)" EndTime="@TimeSpan.FromHours(19)" MinutesPerSlot="30" />
                </RadzenScheduler>
            </div>

            <div class="ag-citas-lista">
                <div class="ag-citas-lista-encabezado">
                    <h3>Citas agendadas</h3>
                    <span class="ag-label-caps">@_totalCitas cita(s)</span>
                </div>

                <RadzenDataGrid @ref="_grid" TItem="CitaListViewModel" Data="@_citas"
                                LoadData="@(CargarPaginaAsync)" Count="@_totalCitas"
                                AllowPaging="true" PageSize="10" PagerPageSizeOptions="@(false)" AllowSorting="false" Width="100%">
                    <Columns>
                        <RadzenDataGridColumn TItem="CitaListViewModel" Title="" Width="70px">
                            <Template Context="cita">
                                @if (!string.IsNullOrEmpty(cita.ImagenUrl))
                                {
                                    <img src="@cita.ImagenUrl" class="event-image" alt="" />
                                }
                                else
                                {
                                    <span class="ag-citas-sinimagen">
                                        <i class="fa-regular fa-calendar-check" aria-hidden="true"></i>
                                    </span>
                                }
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="CitaListViewModel" Property="Nombre" Title="Cliente" />
                        <RadzenDataGridColumn TItem="CitaListViewModel" Property="Fecha" Title="Fecha">
                            <Template Context="cita">
                                <span class="event-date">@cita.Fecha.ToString("dddd d 'de' MMMM 'de' yyyy, h:mm tt")</span>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="CitaListViewModel" Sortable="false" Width="90px" TextAlign="TextAlign.Center">
                            <Template Context="cita">
                                <a href="@($"citadetails/{cita.CitaId}")" class="event-purchase-button btn"
                                   title="Editar cita">
                                    <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
                                </a>
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </div>
        }

        @if (_errorExport is not null)
        {
            <div class="alert alert-warning mt-3">@_errorExport</div>
        }
    </div>
</section>
