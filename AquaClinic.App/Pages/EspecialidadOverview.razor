@page "/especialidadoverview"
@attribute [Authorize]
@rendermode InteractiveServer

<div class="ag-contenedor" style="padding-top: 24px;">
    <h1 class="page-title">@TextoUi.T("Especialidades")</h1>

    <p class="mt-3"><input class="custom-checkbox" type="checkbox" id="incluirHistorial" @onchange="OnIncluirHistorialChanged" /> <label for="incluirHistorial">@TextoUi.T("¿Incluir citas pasadas?")</label></p>

    @if (Especialidades == null)
    {
        <p><em>@TextoUi.T("Cargando...")</em></p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>@TextoUi.T("Especialidad")</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cat in Especialidades)
                {
                    <tr>
                        <td class="event-name">@TextoUi.T(cat.Nombre)</td>

                    </tr>
                    <tr>
                        <td>
                            <table class="nested-table ms-auto me-auto">
                                <thead>
                                    <tr>
                                        <th>@TextoUi.T("Nombre")</th>
                                        <th class="category-event-header">@TextoUi.T("Fecha")</th>
                                        <th class="category-event-header">@TextoUi.T("Doctor")</th>
                                        <th class="category-event-header">@TextoUi.T("Precio")</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var ev in cat.Citas)
                                    {
                                        <tr>
                                            <td class="event-name">@TextoUi.T(ev.Nombre)</td>
                                            <td class="event-date">@ev.Fecha.ToString("d", System.Globalization.CultureInfo.CurrentCulture)</td>
                                            <td class="event-artist">@ev.Doctor</td>
                                            <td class="event-price">@ev.Precio</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
