@page "/cambiarpassword"
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>@TextoUi.T("Cambiar contraseña")</PageTitle>

<div class="ag-contenedor ag-perfil" style="padding-top: 24px;">
    <h1 class="page-title">@TextoUi.T("Cambiar contraseña")</h1>

    @if (!string.IsNullOrEmpty(MensajeExito))
    {
        <div class="alert alert-success">@TextoUi.T(MensajeExito)</div>
    }
    @if (!string.IsNullOrEmpty(MensajeError))
    {
        <div class="alert alert-danger">@TextoUi.T(MensajeError)</div>
    }

    <div class="ag-panel" style="max-width: 720px;">
        <EditForm Model="Modelo" OnValidSubmit="HandleCambiar">
            <DataAnnotationsValidator />
            <ValidationSummary></ValidationSummary>

            <div class="row mb-3">
                <label class="col-sm-3 col-form-label">@TextoUi.T("Contraseña actual:")</label>
                <div class="col-sm-9">
                    <InputText type="password" class="form-control" @bind-Value="Modelo.PasswordActual" />
                </div>
            </div>

            <div class="row mb-3">
                <label class="col-sm-3 col-form-label">@TextoUi.T("Nueva contraseña:")</label>
                <div class="col-sm-9">
                    <InputText type="password" class="form-control" @bind-Value="Modelo.PasswordNueva" />
                    <ValidationMessage For="@(() => Modelo.PasswordNueva)" />
                </div>
            </div>

            <div class="row mb-3">
                <label class="col-sm-3 col-form-label">@TextoUi.T("Confirmar:")</label>
                <div class="col-sm-9">
                    <InputText type="password" class="form-control" @bind-Value="Modelo.PasswordNuevaConfirmacion" />
                    <ValidationMessage For="@(() => Modelo.PasswordNuevaConfirmacion)" />
                </div>
            </div>

            @if (!string.IsNullOrEmpty(TokenRestablecimiento))
            {
                <div class="alert alert-info mt-3">
                    <p><strong>@TextoUi.T("Restablecimiento:")</strong> @TextoUi.T("Si olvidaste tu contraseña, usa este codigo:")</p>
                    <textarea class="form-control" rows="3" readonly>@TokenRestablecimiento</textarea>
                </div>
            }

            <div class="ag-perfil-acciones">
                <button type="submit" class="submit-button">@TextoUi.T("Cambiar contraseña")</button>
                <a href="/perfil" class="ag-perfil-btn-secundario">@TextoUi.T("Volver al perfil")</a>
            </div>
        </EditForm>
    </div>
</div>
