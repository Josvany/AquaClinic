@page "/cambiarpassword"
@rendermode InteractiveServer

<PageTitle>Cambiar contrase&#241;a</PageTitle>

<h1 class="page-title">Cambiar contrase&#241;a</h1>

@Message

<EditForm Model="Modelo" OnValidSubmit="HandleCambiar">
    <DataAnnotationsValidator />
    <ValidationSummary></ValidationSummary>

    <div class="row mb-3">
        <label class="col-sm-3 col-form-label">Contrase&#241;a actual:</label>
        <div class="col-sm-8">
            <InputText type="password" class="form-control" @bind-Value="Modelo.PasswordActual" />
        </div>
    </div>

    <div class="row mb-3">
        <label class="col-sm-3 col-form-label">Nueva contrase&#241;a:</label>
        <div class="col-sm-8">
            <InputText type="password" class="form-control" @bind-Value="Modelo.PasswordNueva" />
        </div>
    </div>

    <div class="row mb-3">
        <label class="col-sm-3 col-form-label">Confirmar:</label>
        <div class="col-sm-8">
            <InputText type="password" class="form-control" @bind-Value="Modelo.PasswordNuevaConfirmacion" />
            <ValidationMessage For="@(() => Modelo.PasswordNuevaConfirmacion)" />
        </div>
    </div>

    @if (!string.IsNullOrEmpty(TokenRestablecimiento))
    {
        <div class="alert alert-info mt-3">
            <p><strong>Restablecimiento:</strong> Si olvidaste tu contrase&#241;a, usa este codigo:</p>
            <textarea class="form-control" rows="3" readonly>@TokenRestablecimiento</textarea>
        </div>
    }

    <button type="submit" class="submit-button">Cambiar contrase&#241;a</button>
</EditForm>

<br />
<p class="mt-3"><a href="/perfil">Volver al perfil</a></p>
