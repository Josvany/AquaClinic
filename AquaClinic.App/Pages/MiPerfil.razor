@page "/perfil"
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>@TextoUi.T("Mi perfil")</PageTitle>

<div class="ag-contenedor ag-perfil" style="padding-top: 24px;">
    <h1 class="page-title">@TextoUi.T("Mi perfil")</h1>

    @if (Cargando)
    {
        <p><em>@TextoUi.T("Cargando...")</em></p>
    }
    else if (Usuario == null)
    {
        <div class="alert alert-warning">@TextoUi.T("No se pudo cargar el perfil. Verifica que la API esté corriendo.")</div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(MensajeExito))
        {
            <div class="alert alert-success">@TextoUi.T(MensajeExito)</div>
        }
        @if (!string.IsNullOrEmpty(MensajeError))
        {
            <div class="alert alert-danger">@TextoUi.T(MensajeError)</div>
        }

        <div class="ag-panel" style="max-width: 720px;">
            <EditForm Model="Usuario" OnValidSubmit="HandleGuardar">
                <DataAnnotationsValidator />

                <div class="row mb-3">
                    <label class="col-sm-3 col-form-label">@TextoUi.T("Correo:")</label>
                    <div class="col-sm-9">
                        <input class="form-control" value="@Usuario.Email" readonly />
                    </div>
                </div>

                <div class="row mb-3">
                    <label class="col-sm-3 col-form-label">@TextoUi.T("Nombre:")</label>
                    <div class="col-sm-9">
                        <InputText class="form-control" @bind-Value="Usuario.Nombre" />
                    </div>
                </div>

                <div class="row mb-3">
                    <label class="col-sm-3 col-form-label">@TextoUi.T("Apellidos:")</label>
                    <div class="col-sm-9">
                        <InputText class="form-control" @bind-Value="Usuario.Apellidos" />
                    </div>
                </div>

                <div class="row mb-3">
                    <label class="col-sm-3 col-form-label">@TextoUi.T("Teléfono:")</label>
                    <div class="col-sm-9">
                        <InputText class="form-control" @bind-Value="Usuario.Telefono" />
                    </div>
                </div>

                <div class="row mb-3">
                    <label class="col-sm-3 col-form-label">@TextoUi.T("Roles:")</label>
                    <div class="col-sm-9">
                        <span class="badge bg-info">@string.Join(", ", Usuario.Roles)</span>
                    </div>
                </div>

                <div class="ag-perfil-acciones">
                    <button type="submit" class="submit-button">@TextoUi.T("Guardar cambios")</button>
                    <a href="/cambiarpassword" class="ag-perfil-btn-secundario">@TextoUi.T("Cambiar contrase��a")</a>
                </div>

        <div class="ag-panel" style="max-width:720px; margin-top:24px; border:1px solid #f1c0c0;">
            <h3 style="color:#a63a3a;">@TextoUi.T("Privacidad y datos")</h3>
            <p style="font-size:0.9rem; color:var(--ag-texto-suave);">
                @TextoUi.T("Puedes descargar una copia de tus datos o eliminar tu cuenta. La eliminación es permanente y no se puede deshacer.")
            </p>
            <div class="ag-perfil-acciones">
                <button class="ag-perfil-btn-secundario" @onclick="ExportarDatos">@TextoUi.T("Exportar mis datos")</button>
                <button class="ag-perfil-btn-secundario" style="color:#a63a3a; border-color:#a63a3a;" @onclick="EliminarCuenta">@TextoUi.T("Eliminar mi cuenta")</button>
            </div>
            @if (!string.IsNullOrEmpty(MensajeDatos))
            {
                <div class="alert alert-info mt-2">@MensajeDatos</div>
            }
        </div>
            </EditForm>
        </div>
    }
</div>
