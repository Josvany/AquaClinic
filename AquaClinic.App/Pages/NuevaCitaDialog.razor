@rendermode InteractiveServer

<div class="ag-reserva-modal ag-nueva-cita">
    @if (_error is not null)
    {
        <div class="ag-nueva-cita-error">@TextoUi.T(_error)</div>
    }

    <div class="ag-field">
        <label>@TextoUi.T("Tipo de cliente")</label>
        <div class="ag-tipo-cliente" role="group" aria-label="@TextoUi.T("Tipo de cliente")">
            <button type="button" class="ag-tipo-cliente-opcion @(_esRegistrado ? "ag-tipo-cliente-activa" : null)"
                    @onclick="() => ElegirTipoCliente(true)">
                <i class="fa-regular fa-user" aria-hidden="true"></i> Cliente registrado
            </button>
            <button type="button" class="ag-tipo-cliente-opcion @(!_esRegistrado ? "ag-tipo-cliente-activa" : null)"
                    @onclick="() => ElegirTipoCliente(false)">
                <i class="fa-regular fa-user-plus" aria-hidden="true"></i> Cliente no registrado
            </button>
        </div>
    </div>

    @if (_esRegistrado)
    {
        <div class="ag-field">
            <label>@TextoUi.T("Cliente")</label>
            <div class="ag-buscar-cliente">
                <RadzenTextBox @bind-Value="_busquedaCliente" Placeholder="Buscar por nombre o correo" />
                <RadzenButton Text="@TextoUi.T("Buscar")" ButtonStyle="ButtonStyle.Secondary" Disabled="@_buscando"
                              Click="@(async () => await BuscarClientesAsync())" />
            </div>
            <RadzenDropDown @bind-Value="_clienteId" Data="@_clientes" TextProperty="Etiqueta" ValueProperty="UsuarioId"
                            AllowFiltering="true" Placeholder="Elige el cliente" Style="width:100%;" />

            @if (_clientes.Count == 0)
            {
                <small class="ag-nueva-cita-aviso">@TextoUi.T("No hay clientes registrados que coincidan con la búsqueda.")</small>
            }
        </div>
    }
    else
    {
        <div class="ag-field">
            <label>@TextoUi.T("Nombre completo")</label>
            <RadzenTextBox @bind-Value="_nombre" Placeholder="Nombre del cliente" />
        </div>

        <div class="ag-field">
            <label>@TextoUi.T("Correo")</label>
            <RadzenTextBox @bind-Value="_correo" Placeholder="cliente@correo.com" />
        </div>

        <div class="ag-field">
            <label>@TextoUi.T("Teléfono (opcional)")</label>
            <RadzenTextBox @bind-Value="_telefono" Placeholder="+1 604 ..." />
        </div>
    }

    <div class="ag-field">
        <label>@TextoUi.T("Servicio")</label>
        <RadzenDropDown Value="@_servicioId" Change="@(async (object? s) => await AlCambiarServicioAsync((Guid)s))"
                        Data="@_servicios" TextProperty="Nombre" ValueProperty="ServicioId" TValue="System.Guid"
                        AllowFiltering="true" Placeholder="Elige un servicio" Style="width:100%;" />
    </div>

    <div class="ag-fila-doble">
        <div class="ag-field">
            <label>@TextoUi.T("Fecha")</label>
            <RadzenDatePicker Value="@_fecha" Min="@AgendaCalendario.HoyClinica" ValueChanged="@(async (DateTime? f) => await AlCambiarFechaAsync(f))"
                              DateFormat="dd/MM/yyyy" Style="width:100%;" />
        </div>

        <div class="ag-field">
            <label>@TextoUi.T("Hora")</label>
            <RadzenDropDown Value="@_hora" Change="@(async (object? h) => await AlCambiarHoraAsync(h as OpcionHora))"
                            Data="@_horas" TextProperty="Texto"
                            TValue="OpcionHora" Placeholder="Elige una hora" Style="width:100%;" />
            @if (_horas.Any(h => h.Ocupada))
            {
                <small class="ag-nueva-cita-aviso">@TextoUi.T("Las horas marcadas \"(ocupada)\" ya tienen una cita y no se pueden elegir.")</small>
            }
        </div>
    </div>

    <div class="ag-field">
        <label>@TextoUi.T("Notas (opcional)")</label>
        <RadzenTextArea @bind-Value="_notas" Rows="2" Placeholder="Alergias, preferencias, ..." />
    </div>

    <div class="ag-reserva-acciones">
        <RadzenButton Text="@TextoUi.T("Crear cita")" ButtonStyle="ButtonStyle.Primary" Disabled="@_enviando"
                      Click="@(async () => await Enviar())" />
        <RadzenButton Text="@TextoUi.T("Cancelar")" ButtonStyle="ButtonStyle.Secondary" Disabled="@_enviando"
                      Click="@Cancelar" />
    </div>
</div>
