@rendermode InteractiveServer
@inject IServiciosPublicosDataService Servicios
@inject IReservasDataService Reservas
@inject IUsuarioDataService Usuarios
@inject SeleccionReservaEstado SeleccionReserva
@inject DialogService Dialogs
@inject NotificadorUi Notificador

<div class="ag-reserva-modal">
    @if (_enviada)
    {
        <div class="ag-booking-confirmacion">
            <h3>&#161;Cita recibida!</h3>
            <p>
                Te esperamos el <strong>@_fechaInicio.ToString("dddd, d 'de' MMMM 'de' yyyy")</strong>
                a las <strong>@_fechaInicio.ToString("hh\\:mm tt")</strong>.
            </p>
            <p style="font-size:0.92rem; color:var(--ag-tinta);">@_servicioNombre</p>
            <RadzenButton Text="Listo" Click="@(async () => await OnConfirmarAsync(true))" ButtonStyle="ButtonStyle.Primary" Style="width:100%;" />
        </div>
    }
    else
    {
        <p class="ag-reserva-modal-fecha">
            <i class="fa-regular fa-calendar-check" aria-hidden="true"></i>
            @_fechaInicio.ToString("dddd, d 'de' MMMM 'de' yyyy · hh\\:mm tt")
        </p>

        <RadzenTemplateForm TItem="object" Data="@_modelo" Submit="@Enviar">
            <div class="ag-field">
                <label>Servicio</label>
                <RadzenDropDown Value="@_servicioId" Change="@(async (object? s) => await AlElegirServicioAsync((Guid)s))"
                                Name="servicio" AllowFiltering="true" TextProperty="EtiquetaDropdown" ValueProperty="ServicioId"
                                Data="@_servicios" TValue="System.Guid" Placeholder="Elige un servicio" Style="width:100%;" />
                <RadzenRequiredValidator Component="servicio" Text="Elige un servicio" Popup="false" />
                @if (_error is not null)
                {
                    <div class="ag-nueva-cita-error">@_error</div>
                }
            </div>

            @if (_sugerencias.Count > 0)
            {
                <div class="ag-reserva-sugerencias">
                    <p>
                        <i class="fa-solid fa-lightbulb" aria-hidden="true"></i>
                        No cabe completa desde las @_fechaInicio.ToString("hh\\:mm tt"). Horas libres donde s&iacute; cabe:
                    </p>
                    <RadzenRow class="ag-reserva-sugerencias-fila">
                        @foreach (var sugerida in _sugerencias)
                        {
                            var etiqueta = EtiquetaDiaSugerida(sugerida);
                            <RadzenColumn Size="4">
                                <button type="button" class="ag-reserva-sugerencia" @onclick="@(async () => await ReAnclarAsync(sugerida))">
                                    @sugerida.ToString("hh\\:mm tt")
                                    @if (etiqueta is not null)
                                    {
                                        <span class="ag-reserva-sugerencia-dia">@etiqueta</span>
                                    }
                                </button>
                            </RadzenColumn>
                        }
                    </RadzenRow>
                </div>
            }

            @if (_esInvitado)
            {
                <div class="ag-reserva-dos-columnas">
                    <div class="ag-field">
                        <label>Nombre completo</label>
                        <RadzenTextBox @bind-Value="_nombre" Name="nombre" Placeholder="Tu nombre" />
                        <RadzenRequiredValidator Component="nombre" Text="Escribe tu nombre" Popup="false" />
                    </div>

                    <div class="ag-field">
                        <label>Correo</label>
                        <RadzenTextBox @bind-Value="_correo" Name="correo" Placeholder="tu@correo.com" />
                        <RadzenRequiredValidator Component="correo" Text="Escribe tu correo" Popup="false" />
                        <RadzenEmailValidator Component="correo" Text="Revisa el formato del correo" Popup="false" />
                    </div>

                    <div class="ag-field">
                        <label>Tel&eacute;fono (opcional)</label>
                        <RadzenTextBox @bind-Value="_telefono" Name="telefono" Placeholder="+1 604 ..." />
                    </div>

                    <div class="ag-field">
                        <label>Notas (opcional)</label>
                        <RadzenTextArea @bind-Value="_notas" Name="notas" Rows="2" Placeholder="Alergias, preferencias, ..." />
                    </div>
                </div>
            }

            <div class="ag-reserva-acciones">
                <RadzenButton ButtonType="ButtonType.Submit" Text="Confirmar cita"
                              ButtonStyle="ButtonStyle.Primary" Disabled="@_enviando" />
                <RadzenButton Text="Cancelar" Click="@OnCancelarAsync"
                              ButtonStyle="ButtonStyle.Secondary" Disabled="@_enviando" />
            </div>
        </RadzenTemplateForm>
    }
</div>

@code {
    [Parameter] public DateTime FechaInicioLocal { get; set; }
    [Parameter] public DateTime FechaFinLocal { get; set; }
    /// <summary>Ocupaciones de la semana (citas + reservas en curso) para validar que
    /// la duracion del servicio elegido no se solape con otra cita. Puede ser null:
    /// entonces se usa el getter OcupacionesProvider para leer la lista VIVA.</summary>
    [Parameter] public List<OcupacionAgenda> Ocupaciones { get; set; } = [];

    /// <summary>Getter de las ocupaciones actuales (la pagina lo pasa para que el
    /// modal lea la lista fresca al elegir servicio, no un snapshot viejo).</summary>
    [Parameter] public Func<List<OcupacionAgenda>>? OcupacionesProvider { get; set; }
    [Parameter] public EventCallback<(bool Exito, DateTime FechaLocal)> ReservaConfirmada { get; set; }
    [Parameter] public EventCallback ReservaCancelada { get; set; }
    /// <summary>Cambio el alcance de la reserva suave en curso: al elegir servicio
    /// (la duracion de la sesion manda) o al re-anclar a una hora sugerida. La
    /// pagina ajusta el bloque "Reservando" al rango [inicio, inicio + duracion].</summary>
    [Parameter] public EventCallback<(DateTime Inicio, int DuracionMinutos)> ReservaActualizada { get; set; }

    private object _modelo = new();
    private List<ServicioPublicoVm> _servicios = [];
    private Guid _servicioId;
    private string _servicioNombre = string.Empty;
    private string _nombre = string.Empty;
    private string _correo = string.Empty;
    private string _telefono = string.Empty;
    private string _notas = string.Empty;
    private bool _esInvitado = true;
    private bool _enviada;
    private bool _enviando;
    private string? _error;

    // Hora de inicio ACTUAL de la reserva (puede cambiar via re-anclaje)
    private DateTime _fechaInicio;

    /// <summary>Horas alternas donde el servicio elegido si cabe (vacias si cabe en la hora elegida).</summary>
    private List<DateTime> _sugerencias = [];

    private const int PasoMinutos = 15;

    /// <summary>Horario de atencion por dia: ESPEJO del seed de HorariosClinica
    /// (AquaClinicDbContext). La App no consulta la tabla: la API es quien valida
    /// el horario real al crear la cita (409 si no cabe). Domingo cerrado; si se
    /// cambia el seed, actualizar este espejo.</summary>
    private static readonly TimeSpan AperturaLunesAViernes = new(9, 0, 0);
    private static readonly TimeSpan CierreLunesAViernes = new(18, 0, 0);
    private static readonly TimeSpan AperturaSabado = new(10, 0, 0);
    private static readonly TimeSpan CierreSabado = new(16, 0, 0);

    protected override async Task OnInitializedAsync()
    {
        _fechaInicio = FechaInicioLocal;

        try
        {
            _servicios = (await Servicios.ObtenerServiciosAsync()).ToList();

            // Servicio elegido en la pagina (dropdown sobre el calendario): preseleccion
            var preseleccion = SeleccionReserva.ServicioElegido;
            if (preseleccion is not null && _servicios.Any(s => s.ServicioId == preseleccion.ServicioId))
            {
                _servicioId = preseleccion.ServicioId;
                _servicioNombre = preseleccion.Nombre;
            }
            else if (SeleccionReserva.ServicioSugeridoId is Guid sugerido)
            {
                // Servicio sugerido por id (banner del index): resolver contra el
                // catalogo; si el id no existe se ignora y el modal queda sin preseleccion
                var servicioSugerido = _servicios.FirstOrDefault(s => s.ServicioId == sugerido);
                if (servicioSugerido is not null)
                {
                    _servicioId = servicioSugerido.ServicioId;
                    _servicioNombre = servicioSugerido.Nombre;
                }
            }

            // Si hay sesion, precargar datos y no pedir contacto
            var usuario = await Usuarios.GetUsuarioActualAsync();
            if (usuario is not null)
            {
                _esInvitado = false;
                _nombre = usuario.Nombre is null ? "" : $"{usuario.Nombre} {usuario.Apellidos}".Trim();
                _correo = usuario.Email;
                _telefono = usuario.Telefono ?? string.Empty;
            }

            // Validar la duracion del servicio preseleccionado contra la hora inicial
            if (_servicioId != Guid.Empty)
            {
                ValidarEncaje();

                // Igual que al elegir a mano: la reserva suave abarca la sesion
                // completa (inicio + duracion del servicio), no solo el slot de 15 min
                if (DuracionElegida > 0 && _error is null)
                {
                    await ReservaActualizada.InvokeAsync((_fechaInicio, DuracionElegida));
                }
            }
        }
        catch (Exception)
        {
            _error = "No se pudo cargar el catálogo de servicios. Intenta de nuevo.";
            Notificador.Error(_error, "No hay conexión");
        }
    }

    private int DuracionElegida =>
        _servicios.FirstOrDefault(s => s.ServicioId == _servicioId)?.DuracionMinutos ?? 0;

    private async Task AlElegirServicioAsync(Guid servicioId)
    {
        _servicioId = servicioId;
        _servicioNombre = _servicios.FirstOrDefault(s => s.ServicioId == servicioId)?.Nombre ?? string.Empty;
        _error = null;

        ValidarEncaje();

        // La reserva suave (bloque "Reservando") debe abarcar toda la sesion,
        // no solo el slot de 15 min del clic: 9:00 + 45 min => 9:00-9:45 para
        // todos los visitantes. Solo si el servicio SI cabe (si no, la reserva
        // queda en el slot inicial hasta elegir una hora sugerida).
        if (_servicioId != Guid.Empty && DuracionElegida > 0 && _error is null)
        {
            await ReservaActualizada.InvokeAsync((_fechaInicio, DuracionElegida));
        }

        await Task.CompletedTask;
    }

    /// <summary>
    /// Si la cita completa no cabe en la hora actual, calcula sugerencias de
    /// horas alternas (pasos de 15 min, mismo dia, dentro del horario de la
    /// clinica y sin solapamientos); si cabe, limpia el estado de error.
    /// </summary>
    private void ValidarEncaje()
    {
        _sugerencias = [];

        if (_servicioId == Guid.Empty || DuracionElegida == 0)
        {
            _error = null;
            return;
        }

        if (CabeCompleto(_fechaInicio, DuracionElegida))
        {
            _error = null;
            return;
        }

        MarcarNoCabe();
    }

    /// <summary>La cita elegida no cabe en la hora actual: marca el error y
    /// calcula las sugerencias (con mensaje distinto si no hay ninguna).
    /// Devuelve el mensaje para notificar sin advertencias de nulabilidad.</summary>
    private string MarcarNoCabe()
    {
        _sugerencias = CalcularSugerencias(DuracionElegida);
        _error = _sugerencias.Count > 0
            ? $"\"{_servicioNombre}\" dura {DuracionElegida} min y no cabe completa en ese horario. Elige una hora sugerida:"
            : $"\"{_servicioNombre}\" dura {DuracionElegida} min y no cabe completa en ese horario, y no hay horas libres en los próximos días.";
        return _error;
    }

    private List<OcupacionAgenda> OcupacionesActuales =>
        OcupacionesProvider?.Invoke() ?? Ocupaciones;

    private bool CabeCompleto(DateTime inicio, int duracionMinutos)
    {
        var fin = inicio.AddMinutes(duracionMinutos);

        // Mismo dia, dentro del horario de atencion de ESE dia (el sábado abre
        // 10:00-16:00, el resto 9:00-18:00: misma regla que valida la API)
        var (aperturaDia, cierreDia) = HorarioDe(inicio.DayOfWeek);
        if (fin.Date != inicio.Date || fin.TimeOfDay > cierreDia || inicio.TimeOfDay < aperturaDia)
        {
            return false;
        }

        // Sin solapamiento: bloquean las citas confirmadas y las reservas suaves de
        // otros usuarios. La reserva suave PROPIA (Estado Reservando en la hora de
        // inicio actual) se excluye por _fechaInicio: su bloque puede abarcar toda
        // la duracion del servicio, asi que no se puede excluir por rango.
        return !OcupacionesActuales.Any(o =>
            !(o.Estado == AgendaCalendario.Reservando && o.Inicio == _fechaInicio) &&
            o.Inicio < fin && o.Fin > inicio);
    }

    /// <summary>
    /// Horas donde la cita completa cabe, en pasos de 15 min. Si la hora elegida
    /// cae en un dia futuro, ademas de las horas DESPUES de la seleccion se
    /// sugieren las horas ANTERIORES del mismo dia (maximo 4 antes y 4 despues),
    /// siempre y cuando haya espacio. De hoy solo se sugieren horas que aun no
    /// pasan; si hoy no alcanza (ej. quedan 15 min antes del cierre), la
    /// sugerencia salta a la apertura del dia siguiente.
    /// </summary>
    private List<DateTime> CalcularSugerencias(int duracionMinutos)
    {
        var ocupaciones = OcupacionesActuales;
        var ahora = AhoraClinica;

        // Sin solapamiento (la reserva suave propia se excluye por _fechaInicio:
        // su bloque puede abarcar toda la sesion, asi que no se compara por rango)
        bool Libre(DateTime hora, DateTime fin) =>
            !ocupaciones.Any(o =>
                !(o.Estado == AgendaCalendario.Reservando && o.Inicio == _fechaInicio) &&
                o.Inicio < fin && o.Fin > hora);

        var anteriores = new List<DateTime>();

        // Dia futuro: horas ANTERIORES del mismo dia (de la apertura hasta justo
        // antes de la elegida). En el dia de hoy no se sugieren horas pasadas,
        // por eso este barrido es solo para fechas posteriores a hoy.
        if (_fechaInicio.Date > ahora.Date)
        {
            for (var hora = _fechaInicio.AddMinutes(-PasoMinutos);
                 hora.Date == _fechaInicio.Date && anteriores.Count < 4;
                 hora = hora.AddMinutes(-PasoMinutos))
            {
                if (hora.DayOfWeek == DayOfWeek.Sunday || hora.TimeOfDay < AperturaDe(hora.DayOfWeek))
                {
                    break; // ya se llego a la apertura (o el dia esta cerrado)
                }

                var fin = hora.AddMinutes(duracionMinutos);
                if (fin.Date != hora.Date || fin.TimeOfDay > CierreDe(hora.DayOfWeek))
                {
                    continue; // mas tarde no cabe; probando una hora antes si
                }

                if (Libre(hora, fin))
                {
                    anteriores.Add(hora);
                }
            }

            anteriores.Reverse(); // de la mas temprana a la mas cercana a la elegida
        }

        var posteriores = new List<DateTime>();
        var limite = _fechaInicio.Date.AddDays(7);

        for (var hora = _fechaInicio; hora.Date < limite && posteriores.Count < 4; hora = hora.AddMinutes(PasoMinutos))
        {
            // Dia ya pasado: saltar directo a la apertura del dia siguiente
            if (hora.Date < ahora.Date)
            {
                hora = hora.Date.AddDays(1).Add(AperturaDe(hora.AddDays(1).DayOfWeek)).AddMinutes(-PasoMinutos); // el for avanza
                continue;
            }

            // Hoy: las horas ya pasadas no se sugieren (el for sigue avanzando)
            if (hora.Date == ahora.Date && hora <= ahora)
            {
                continue;
            }

            // Domingo cerrado: saltar a la apertura del dia siguiente (lunes 9:00)
            if (hora.DayOfWeek == DayOfWeek.Sunday)
            {
                hora = hora.Date.AddDays(1).Add(AperturaLunesAViernes).AddMinutes(-PasoMinutos); // el for avanza
                continue;
            }

            var fin = hora.AddMinutes(duracionMinutos);

            // La cita completa ya no cabe en el horario del dia: seguir en la
            // apertura del dia siguiente (si hoy solo quedan 15 min pegados al
            // cierre, la sugerencia pasa al dia siguiente)
            if (fin.TimeOfDay > CierreDe(hora.DayOfWeek))
            {
                hora = hora.Date.AddDays(1).Add(AperturaDe(hora.AddDays(1).DayOfWeek)).AddMinutes(-PasoMinutos); // el for avanza
                continue;
            }

            if (!Libre(hora, fin))
            {
                continue;
            }

            posteriores.Add(hora);
        }

        anteriores.AddRange(posteriores);
        return anteriores;
    }

    /// <summary>Aviso junto a una hora sugerida cuando NO es del mismo dia que la
    /// seleccionada: "dia siguiente" o los dias de diferencia. Null si es el
    /// mismo dia (no se rotula nada).</summary>
    private string? EtiquetaDiaSugerida(DateTime sugerida)
    {
        var dias = (sugerida.Date - _fechaInicio.Date).Days;

        if (dias <= 0) return null;

        return dias == 1 ? "día siguiente" : $"{dias} días después";
    }

    /// <summary>Horario de atencion del dia (espejo del seed de HorariosClinica).</summary>
    private static (TimeSpan Apertura, TimeSpan Cierre) HorarioDe(DayOfWeek dia) => dia switch
    {
        DayOfWeek.Sunday => (AperturaLunesAViernes, CierreLunesAViernes), // cerrado: lo bloquea el guard de domingos
        DayOfWeek.Saturday => (AperturaSabado, CierreSabado),
        _ => (AperturaLunesAViernes, CierreLunesAViernes)
    };

    private static TimeSpan AperturaDe(DayOfWeek dia) => HorarioDe(dia).Apertura;

    private static TimeSpan CierreDe(DayOfWeek dia) => HorarioDe(dia).Cierre;

    /// <summary>Hora actual en la zona de la clinica (America/Vancouver): las
    /// sugerencias no deben ofrecer horas que ya pasaron del dia de hoy.</summary>
    private static DateTime AhoraClinica
    {
        get
        {
            try
            {
                var tz = TimeZoneInfo.FindSystemTimeZoneById("America/Vancouver");
                return TimeZoneInfo.ConvertTime(DateTimeOffset.UtcNow, tz).DateTime;
            }
            catch (TimeZoneNotFoundException)
            {
                return DateTime.Now;
            }
            catch (InvalidTimeZoneException)
            {
                return DateTime.Now;
            }
        }
    }

    /// <summary>
    /// Re-ancla la reserva a una hora sugerida: notifica a la pagina (que libera
    /// la reserva suave vieja y toma la nueva) y actualiza la fecha del modal.
    /// </summary>
    private async Task ReAnclarAsync(DateTime nuevaHora)
    {
        SeleccionReserva.ReAnclar(nuevaHora);
        _fechaInicio = nuevaHora;
        _sugerencias = [];
        _error = null;

        // Aviso a la pagina para que sincronice la reserva suave (con la
        // duracion del servicio: el bloque abarca toda la sesion)
        await ReservaActualizada.InvokeAsync((nuevaHora, DuracionElegida));
    }

    private async Task Enviar(object _)
    {
        // Revalidar por si el usuario envia sin volver a tocar el dropdown
        if (_servicioId != Guid.Empty && !CabeCompleto(_fechaInicio, DuracionElegida))
        {
            var mensaje = MarcarNoCabe();
            Notificador.Advertencia(mensaje);
            StateHasChanged();
            return;
        }

        _enviando = true;
        _error = null;

        try
        {
            var usuario = _esInvitado ? null : await Usuarios.GetUsuarioActualAsync();

            var resultado = await Reservas.CrearCitaAsync(new ReservaCitaVm
            {
                ServicioId = _servicioId,
                FechaInicioLocal = _fechaInicio,
                DuracionMinutos = null,
                UsuarioId = usuario?.UsuarioId,
                NombreInvitado = _esInvitado ? _nombre : null,
                EmailInvitado = _esInvitado ? _correo : null,
                TelefonoInvitado = _esInvitado ? _telefono : null,
                Notas = string.IsNullOrWhiteSpace(_notas) ? null : _notas
            });

            if (resultado.Success)
            {
                _servicioNombre = _servicios.FirstOrDefault(s => s.ServicioId == _servicioId)?.Nombre ?? "Servicio";
                _enviada = true;
                Notificador.Exito($"Cita agendada para el {_fechaInicio:dddd d 'de' MMMM} a las {_fechaInicio:hh\\:mm tt}.");
                StateHasChanged();
                return;
            }

            _error = resultado.Message ?? "No se pudo crear la cita.";
            Notificador.Error(_error);
        }
        catch (HttpRequestException)
        {
            _error = "No se pudo conectar con la API. Verifica tu conexión.";
            Notificador.Error(_error);
        }
        finally
        {
            _enviando = false;
        }
    }

    private async Task OnConfirmarAsync(bool _)
    {
        await ReservaConfirmada.InvokeAsync((true, _fechaInicio));
        Dialogs.Close();
    }

    private async Task OnCancelarAsync()
    {
        // La pagina libera la reserva suave en su callback
        await ReservaCancelada.InvokeAsync();
        Dialogs.Close();
    }
}
