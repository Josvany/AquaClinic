@page "/serviciooverview"
@attribute [Authorize]
@rendermode InteractiveServer
@inject IServicioDataService ServicioDataService
@inject DialogService Dialogs
@inject NotificadorUi Notificador

<PageTitle>@TextoUi.T("Servicios") — @TextoUi.T("Administración")</PageTitle>

<section class="ag-citas-seccion">
    <div class="ag-contenedor">
        <div class="ag-citas-encabezado">
            <div>
                <span class="ag-label-caps">@TextoUi.T("Catálogo")</span>
                <h1 class="page-title">@TextoUi.T("Servicios")</h1>
                <p class="ag-citas-subtitulo">
                    @TextoUi.T("Los servicios activos aparecen en la portada y pueden agendarse. Eliminar un servicio solo lo desactiva: sale del catálogo y ya no se puede agendar, pero su historial de citas se conserva.")
                </p>
            </div>
            <div class="ag-citas-acciones">
                <RadzenButton Text="@TextoUi.T("Nuevo servicio")" Icon="add_circle_outline"
                              ButtonStyle="ButtonStyle.Primary" Click="@AbrirCrearAsync" />
            </div>
        </div>

        @if (_errorCarga is not null)
        {
            <div class="alert alert-warning">@TextoUi.T(_errorCarga)</div>
        }
        else if (_cargando)
        {
            <p><em>@TextoUi.T("Cargando...")</em></p>
        }
        else
        {
            <div class="ag-panel">
                <RadzenDataGrid TItem="ServicioViewModel" Data="@_servicios"
                                AllowPaging="true" PageSize="10" PagerPageSizeOptions="@(false)"
                                AllowSorting="true" Width="100%">
                    <Columns>
                        <RadzenDataGridColumn TItem="ServicioViewModel" Title="@TextoUi.T("Servicio")" Sortable="false">
                            <Template Context="servicio">
                                <strong>@servicio.Nombre</strong>
                                @if (!string.IsNullOrWhiteSpace(servicio.Descripcion))
                                {
                                    <p class="ag-servicios-descripcion">@TextoUi.T(servicio.Descripcion)</p>
                                }
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ServicioViewModel" Title="@TextoUi.T("Especialidad")">
                            <Template Context="servicio">@TextoUi.T(servicio.EspecialidadNombre)</Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ServicioViewModel" Title="@TextoUi.T("Duración")" Width="110px">
                            <Template Context="servicio">@servicio.DuracionMinutos min</Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ServicioViewModel" Title="@TextoUi.T("Precio")" Width="120px">
                            <Template Context="servicio">
                                @servicio.Precio.ToString("C", FormatoClinica.CulturaDinero)
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ServicioViewModel" Title="" Width="130px" Sortable="false">
                            <Template Context="servicio">
                                <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small"
                                              Click="@(() => AbrirEditarAsync(servicio))" />
                                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                              Click="@(() => ConfirmarEliminarAsync(servicio))" />
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </div>
        }
    </div>
</section>

@code {
    private List<ServicioViewModel> _servicios = [];
    private bool _cargando = true;
    private string? _errorCarga;

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        _cargando = true;

        try
        {
            _servicios = await ServicioDataService.ObtenerTodosAsync();
            _errorCarga = null;
        }
        catch (HttpRequestException)
        {
            _errorCarga = "No se pudo conectar con la API. Verifica que esté corriendo.";
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task AbrirCrearAsync()
    {
        await Dialogs.OpenAsync<ServicioFormDialog>(TextoUi.T("Nuevo servicio"),
            new Dictionary<string, object> { { "OnGuardado", EventCallback.Factory.Create(this, CargarAsync) } },
            new DialogOptions { Width = "640px", ShowClose = true, CloseDialogOnEsc = true, CloseDialogOnOverlayClick = false, Draggable = false, CssClass = "ag-dialog" });
    }

    private async Task AbrirEditarAsync(ServicioViewModel servicio)
    {
        await Dialogs.OpenAsync<ServicioFormDialog>(TextoUi.T("Editar servicio"),
            new Dictionary<string, object>
            {
                { "ServicioId", servicio.ServicioId },
                { "OnGuardado", EventCallback.Factory.Create(this, CargarAsync) }
            },
            new DialogOptions { Width = "640px", ShowClose = true, CloseDialogOnEsc = true, CloseDialogOnOverlayClick = false, Draggable = false, CssClass = "ag-dialog" });
    }

    private async Task ConfirmarEliminarAsync(ServicioViewModel servicio)
    {
        var confirmado = await Dialogs.Confirm(
            string.Format(TextoUi.T("¿Desactivar el servicio \"{0}\"? Saldrá del catálogo y ya no se podrá agendar."), servicio.Nombre),
            TextoUi.T("Desactivar servicio"),
            new ConfirmOptions { OkButtonText = TextoUi.T("Desactivar"), CancelButtonText = TextoUi.T("Cancelar") }) == true;

        if (!confirmado)
        {
            return;
        }

        var respuesta = await ServicioDataService.EliminarAsync(servicio.ServicioId);

        if (respuesta.Success)
        {
            Notificador.Exito(string.Format(TextoUi.T("Servicio \"{0}\" desactivado."), servicio.Nombre));
            await CargarAsync();
        }
        else
        {
            var detalle = respuesta.Message
                + (string.IsNullOrEmpty(respuesta.ValidationErrors) ? "" : Environment.NewLine + respuesta.ValidationErrors);
            Notificador.Error(TextoUi.T(detalle), TextoUi.T("No se pudo desactivar"));
        }
    }
}
