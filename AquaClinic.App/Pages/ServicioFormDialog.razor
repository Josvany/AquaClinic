@inject IServicioDataService ServicioDataService
@inject IEspecialidadDataService EspecialidadDataService
@inject NotificadorUi Notificador
@inject DialogService Dialogs

<div class="ag-reserva-modal">
    @if (_cargando)
    {
        <p><em>Cargando servicio...</em></p>
    }
    else
    {
        <div class="ag-reserva-form">
            <div class="ag-field">
                <label for="servicio-nombre">Nombre</label>
                <RadzenTextBox @bind-Value="_nombre" Name="nombre" InputId="servicio-nombre" Placeholder="Ej. Limpieza facial profunda" />
            </div>

            <div class="ag-field">
                <label for="servicio-especialidad">Especialidad</label>
                <RadzenDropDown @bind-Value="_especialidadId"
                                Name="especialidad" TextProperty="Nombre" ValueProperty="EspecialidadId"
                                Data="_especialidades" TValue="System.Guid"
                                Placeholder="Elige la especialidad" Style="width:100%;" />
            </div>

            <div class="ag-reserva-dos-columnas">
                <div class="ag-field">
                    <label for="servicio-precio">Precio (CAD)</label>
                    <RadzenNumeric TValue="decimal" @bind-Value="_precio" Name="precio" InputId="servicio-precio" Min="0.01m" Max="10000" />
                </div>

                <div class="ag-field">
                    <label for="servicio-duracion">Duración (minutos)</label>
                    <RadzenNumeric TValue="int" @bind-Value="_duracionMinutos" Name="duracion" InputId="servicio-duracion" Min="5" Max="600" Step="5" />
                </div>
            </div>

            <div class="ag-field">
                <label for="servicio-descripcion">Descripción (opcional)</label>
                <RadzenTextArea @bind-Value="_descripcion" Name="descripcion" Rows="2" Placeholder="Qué incluye el tratamiento..." />
            </div>

            <div class="ag-field">
                <label for="servicio-imagen">URL de imagen (opcional)</label>
                <RadzenTextBox @bind-Value="_imagenUrl" Name="imagen" InputId="servicio-imagen" Placeholder="https://..." />
            </div>

            @if (_error is not null)
            {
                <div class="ag-nueva-cita-error" style="white-space: pre-line;">@_error</div>
            }

            <div class="ag-reserva-acciones">
                <RadzenButton Text="@(_esEditando ? "Guardar cambios" : "Crear servicio")"
                              ButtonStyle="ButtonStyle.Primary" Disabled="_guardando"
                              Click="@GuardarAsync" />
                <RadzenButton Text="Cancelar" Click="@CancelarAsync"
                              ButtonStyle="ButtonStyle.Secondary" Disabled="_guardando" />
            </div>
        </div>
    }
</div>

@code {
    /// <summary>Null o Guid.Empty = crear; con valor = editar ese servicio.</summary>
    [Parameter] public Guid? ServicioId { get; set; }

    /// <summary>La pagina lo invoca cuando el dialogo guardo cambios.</summary>
    [Parameter] public EventCallback OnGuardado { get; set; }

    private List<EspecialidadViewModel> _especialidades = [];
    private bool _cargando = true;
    private bool _guardando;
    private string? _error;

    private string _nombre = string.Empty;
    private Guid _especialidadId;
    private decimal _precio;
    private int _duracionMinutos;
    private string? _descripcion;
    private string? _imagenUrl;

    private bool _esEditando => ServicioId.HasValue && ServicioId.Value != Guid.Empty;
    private Guid _servicioOriginal;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _especialidades = await EspecialidadDataService.GetAllEspecialidades();

            if (_esEditando)
            {
                var servicio = await ServicioDataService.ObtenerPorIdAsync(ServicioId!.Value);

                if (servicio is null)
                {
                    _error = "El servicio no existe o no se pudo cargar.";
                    _cargando = false;
                    return;
                }

                _servicioOriginal = servicio.ServicioId;
                _nombre = servicio.Nombre;
                _especialidadId = servicio.EspecialidadId;
                _precio = servicio.Precio;
                _duracionMinutos = servicio.DuracionMinutos;
                _descripcion = servicio.Descripcion;
                _imagenUrl = servicio.ImagenUrl;
            }
        }
        catch (HttpRequestException)
        {
            _error = "No se pudo conectar con la API. Verifica tu conexión.";
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task GuardarAsync()
    {
        // Validacion explicita y visible: los mismos requisitos que aplica la API
        var errores = new List<string>();

        if (string.IsNullOrWhiteSpace(_nombre))
        {
            errores.Add("El nombre es obligatorio.");
        }
        else if (_nombre.Trim().Length > 50)
        {
            errores.Add("El nombre no debe exceder 50 caracteres.");
        }

        if (_especialidadId == Guid.Empty)
        {
            errores.Add("Elige la especialidad del servicio.");
        }

        if (_precio <= 0)
        {
            errores.Add("El precio debe ser mayor que cero.");
        }

        if (_duracionMinutos <= 0)
        {
            errores.Add("La duración debe ser mayor que cero.");
        }

        if (errores.Count > 0)
        {
            _error = string.Join(Environment.NewLine, errores);
            return;
        }

        _guardando = true;
        _error = null;

        try
        {
            var vm = new ServicioViewModel
            {
                ServicioId = _esEditando ? _servicioOriginal : Guid.Empty,
                Nombre = _nombre.Trim(),
                EspecialidadId = _especialidadId,
                Precio = _precio,
                DuracionMinutos = _duracionMinutos,
                Descripcion = string.IsNullOrWhiteSpace(_descripcion) ? null : _descripcion.Trim(),
                ImagenUrl = string.IsNullOrWhiteSpace(_imagenUrl) ? null : _imagenUrl.Trim()
            };

            if (_esEditando)
            {
                var r = await ServicioDataService.ActualizarAsync(vm);

                if (!r.Success)
                {
                    _error = r.Message
                        + (string.IsNullOrEmpty(r.ValidationErrors) ? "" : Environment.NewLine + r.ValidationErrors.TrimEnd());
                    return;
                }
            }
            else
            {
                var r = await ServicioDataService.CrearAsync(vm);

                if (!r.Success)
                {
                    _error = r.Message
                        + (string.IsNullOrEmpty(r.ValidationErrors) ? "" : Environment.NewLine + r.ValidationErrors.TrimEnd());
                    return;
                }
            }

            Notificador.Exito(_esEditando ? $"Servicio \"{vm.Nombre}\" actualizado." : $"Servicio \"{vm.Nombre}\" creado.");
            await OnGuardado.InvokeAsync();
            Dialogs.Close(true);
        }
        catch (HttpRequestException)
        {
            _error = "No se pudo conectar con la API. Verifica tu conexión.";
        }
        finally
        {
            _guardando = false;
        }
    }

    private async Task CancelarAsync()
    {
        Dialogs.Close(false);
        await Task.CompletedTask;
    }
}
