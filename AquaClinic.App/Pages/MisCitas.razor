@page "/miscitas"
@attribute [Authorize]
@rendermode InteractiveServer
@using AquaClinic.App.ViewModels
@using Radzen.Blazor

<section class="ag-citas-seccion">
    <div class="ag-contenedor">
        <div class="ag-citas-encabezado">
            <div>
                <span class="ag-label-caps">@TextoUi.T("Mi cuenta")</span>
                <h1 class="ag-citas-titulo">@TextoUi.T("Mis citas")</h1>
                <p class="ag-citas-subtitulo">
                    @TextoUi.T("Todas las citas que has agendado en la clínica, de la más reciente a la más antigua.")
                </p>
            </div>
        </div>

        @if (Cargando)
        {
            <p><em>@TextoUi.T("Cargando...")</em></p>
        }
        else if (_error is not null)
        {
            <div class="alert alert-danger">@TextoUi.T(_error)</div>
        }
        else if (Citas.Count == 0)
        {
            <div class="ag-panel ag-miscitas-vacio">
                <i class="fa-regular fa-calendar-check" aria-hidden="true"></i>
                <h3>@TextoUi.T("Aún no tienes citas")</h3>
                <p>@TextoUi.T("Cuando agendes una cita aparecerá aquí con su estado y detalle.")</p>
                <a href="/reservar" class="event-purchase-button btn">@TextoUi.T("Reservar cita")</a>
            </div>
        }
        else
        {
            <div class="ag-panel ag-miscitas-grid">
                <RadzenDataGrid TItem="MiCitaViewModel" Data="@Citas"
                                AllowPaging="true" PageSize="5" PagerPageSizeOptions="@(false)"
                                AllowSorting="false" Width="100%">
                    <Columns>
                        <RadzenDataGridColumn TItem="MiCitaViewModel" Title="@TextoUi.T("Fecha")" Width="90px">
                            <Template Context="cita">
                                <div class="ag-miscitas-fecha">
                                    <span class="ag-miscitas-fecha-dia">@cita.Fecha.ToString("dd")</span>
                                    <span class="ag-miscitas-fecha-mes">@cita.Fecha.ToString("MMM", null)</span>
                                </div>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="MiCitaViewModel" Title="@TextoUi.T("Servicio")">
                            <Template Context="cita">
                                <h3 class="ag-miscitas-servicio">@cita.Servicio</h3>
                                <p class="ag-miscitas-detalle">
                                    <i class="fa-regular fa-clock" aria-hidden="true"></i>
                                    @cita.Fecha.ToString("f", System.Globalization.CultureInfo.CurrentCulture)
                                    @if (cita.Precio > 0)
                                    {
                                        <span class="ag-miscitas-precio">&nbsp;&middot;&nbsp;@cita.Precio.ToString("C", FormatoClinica.CulturaDinero)</span>
                                    }
                                </p>
                                @if (!string.IsNullOrWhiteSpace(cita.Notas))
                                {
                                    <p class="ag-miscitas-notas">@cita.Notas</p>
                                }
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="MiCitaViewModel" Title="@TextoUi.T("Estado")" Width="120px" TextAlign="TextAlign.Center" CssClass="ag-miscitas-col-estado">
                            <Template Context="cita">
                                <span class="ag-miscitas-estado ag-miscitas-estado-@cita.Estado.ToLower()">@TraducirEstado(cita.Estado)</span>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="MiCitaViewModel" Title="@TextoUi.T("Acciones")" Width="230px" TextAlign="TextAlign.Center">
                            <Template Context="cita">
                                @if (cita.PermiteGestionar)
                                {
                                    <div class="ag-miscitas-acciones">
                                        <button type="button" class="ag-miscitas-boton-mover"
                                                title="@TextoUi.T("Cambiar la fecha y la hora de esta cita")"
                                                @onclick="() => MoverCita(cita)">
                                            <i class="fa-regular fa-calendar-clock" aria-hidden="true"></i>
                                            @TextoUi.T("Cambiar cita")
                                        </button>
                                        <button type="button" class="ag-miscitas-boton-cancelar"
                                                title="@TextoUi.T("Cancelar esta cita")"
                                                @onclick="() => CancelarCita(cita)">
                                            <i class="fa-solid fa-circle-xmark" aria-hidden="true"></i>
                                            @TextoUi.T("Cancelar cita")
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <span class="ag-miscitas-sin-accion">&mdash;</span>
                                }
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </div>
        }
    </div>
</section>

@code {
    private static string TraducirEstado(string estado) => TextoUi.T(estado);
}
