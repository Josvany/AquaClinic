@page "/citadetails"
@page "/citadetails/{citaid}"
@attribute [Authorize]
@rendermode InteractiveServer

<section class="ag-citas-seccion">
    <div class="ag-contenedor">
        <div class="ag-citas-encabezado">
            <div>
                <span class="ag-label-caps">@TextoUi.T("Agenda de la clínica")</span>
                <h1 class="ag-citas-titulo">@TextoUi.T("Detalles de la cita")</h1>
                <p class="ag-citas-subtitulo">
                    @TextoUi.T("Consulta el cliente, el servicio y el horario. Solo puedes mover la cita a otro horario o cancelarla.")
                </p>
            </div>
        </div>

        @if (Cargando)
        {
            <p><em>@TextoUi.T("Cargando...")</em></p>
        }
        else if (Error is not null)
        {
            <div class="alert alert-danger">@TextoUi.T(Error)</div>
        }
        else if (Cita is null || Cita.CitaId == Guid.Empty)
        {
            <div class="ag-panel ag-miscitas-vacio">
                <i class="fa-regular fa-calendar-xmark" aria-hidden="true"></i>
                <h3>@TextoUi.T("Cita no encontrada")</h3>
                <p>@TextoUi.T("La cita que buscas no existe o ya fue eliminada.")</p>
            </div>
        }
        else
        {
            <CitaDetalleVista Cita="Cita" OnMover="MoverCita" OnCancelar="CancelarCita" />
        }

        <p class="back-to-catalog mt-3">
            <img src="img/back-arrow.svg" />
            <a @onclick="@VolverAlListado">@TextoUi.T("Volver al listado")</a>
        </p>
    </div>
</section>
