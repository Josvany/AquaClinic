@page "/login"

<PageTitle>@TextoUi.T("Iniciar sesión")</PageTitle>

<div class="ag-auth">
    <div class="ag-auth-card">
        <span class="ag-saludo">@TextoUi.T("Bienvenido de nuevo")</span>
        <h1>@TextoUi.T("Iniciar sesión")</h1>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="alert alert-danger mt-3">@TextoUi.T(ErrorMessage)</div>
        }
        <form method="post" action="/auth/login" class="mt-3">
            <AntiforgeryToken />
            <div class="ag-field">
                <label for="userName">@TextoUi.T("Correo")</label>
                <input type="email" id="userName" name="email" class="form-control login-field"
                       required placeholder="@TextoUi.T("tu@correo.com")" />
            </div>
            <div class="ag-field">
                <label for="password">@TextoUi.T("Contraseña")</label>
                <input type="password" id="password" name="password" class="form-control login-field"
                       required minlength="8" />
            </div>
            <button class="ag-btn ag-auth-submit" type="submit">@TextoUi.T("Iniciar sesión")</button>
        </form>

        <p class="mt-3 mb-0">
            <a href="/register">@TextoUi.T("¿No tienes cuenta? Regístrate")</a>
        </p>
    </div>
</div>
