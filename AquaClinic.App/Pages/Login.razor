@page "/login"

<PageTitle>Iniciar sesi&#243;n</PageTitle>

<div class="ag-auth">
    <div class="ag-auth-card">
        <span class="ag-saludo">Bienvenido de nuevo</span>
        <h1>Iniciar sesi&#243;n</h1>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="alert alert-danger mt-3">@ErrorMessage</div>
        }

        <!-- Formulario HTML estandar: POST a /auth/login (minimal API).
             Evita el pipeline de Blazor (enhanced forms/NavigationException)
             y garantiza que la cookie de la API se copie al navegador. -->
        <form method="post" action="/auth/login" class="mt-3">
            <AntiforgeryToken />
            <div class="ag-field">
                <label for="userName">Correo</label>
                <input type="email" id="userName" name="email" class="form-control login-field"
                       required placeholder="tu@correo.com" />
            </div>
            <div class="ag-field">
                <label for="password">Contrase&#241;a</label>
                <input type="password" id="password" name="password" class="form-control login-field"
                       required minlength="8" />
            </div>
            <button class="ag-btn ag-auth-submit" type="submit">Iniciar sesi&#243;n</button>
        </form>

        <p class="mt-3 mb-0">
            <a href="/register">&#191;No tienes cuenta? Reg&#237;strate</a>
        </p>
    </div>
</div>
