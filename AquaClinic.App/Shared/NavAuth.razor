<AuthorizeView>
    <NotAuthorized>
        <button type="button" class="ag-nav-login" @onclick="AbrirLogin">@TextoUi.T("Iniciar sesion")</button>
    </NotAuthorized>
</AuthorizeView>

@code {
    [Inject]
    private DialogService DialogService { get; set; } = default!;

    private async Task AbrirLogin()
    {
        await DialogService.OpenAsync<LoginDialog>(" ", options: new DialogOptions
        {
            Width = "600px",
            ShowClose = true,
            CloseDialogOnEsc = true,
            CloseDialogOnOverlayClick = true,
            Draggable = false,
            CssClass = "ag-dialog"
        });
    }
}
