<div class="ag-login-dialog ag-registro-dialog">
    <span class="ag-saludo">@TextoUi.T("Crea tu cuenta")</span>
    <h1>@TextoUi.T("Registrarse")</h1>

    @if (!string.IsNullOrEmpty(Error))
    {
        <div class="alert alert-danger mt-3">@TextoUi.T(Error)</div>
    }

    <form method="post" action="/auth/register" class="mt-3">
        <AntiforgeryToken />
        <div class="ag-registro-grid">
            <div class="ag-field">
                <label for="dlgNombre">@TextoUi.T("Nombre")</label>
                <input type="text" id="dlgNombre" name="nombre" class="form-control login-field"
                       placeholder="@TextoUi.T("Tu nombre")" />
            </div>
            <div class="ag-field">
                <label for="dlgApellidos">@TextoUi.T("Apellidos")</label>
                <input type="text" id="dlgApellidos" name="apellidos" class="form-control login-field"
                       placeholder="@TextoUi.T("Tus apellidos")" />
            </div>
            <div class="ag-field">
                <label for="dlgEmail">@TextoUi.T("Correo")</label>
                <input type="email" id="dlgEmail" name="email" class="form-control login-field"
                       required placeholder="@TextoUi.T("tu@correo.com")" />
            </div>
            <div class="ag-field">
                <label for="dlgTelefono">@TextoUi.T("Teléfono (opcional)")</label>
                <input type="tel" id="dlgTelefono" name="telefono" class="form-control login-field"
                       placeholder="@TextoUi.T("Tu teléfono")" />
            </div>
            <div class="ag-field">
                <label for="dlgFechaNacimiento">@TextoUi.T("Fecha de nacimiento")</label>
                <RadzenDatePicker @bind-Value="fechaNacimiento" DateFormat="dd/MM/yyyy" Style="width:100%;" Name="fechaNacimiento" />
                <input type="hidden" name="fechaNacimiento" value="@(fechaNacimiento?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="ag-field">
                <label for="dlgPassword">@TextoUi.T("Contraseña")</label>
                <input type="password" id="dlgPassword" name="password" class="form-control login-field"
                       required minlength="8" placeholder="@TextoUi.T("Mínimo 8 caracteres")" />
            </div>
            <div class="ag-field ag-field--full" style="flex-direction:row; align-items:flex-start; gap:8px;">
                <input type="checkbox" id="dlgConsentimiento" name="consentimiento" value="si" style="margin-top:4px;" />
                <label for="dlgConsentimiento" style="font-size:0.85rem; line-height:1.4;">
                    @TextoUi.T("Acepto recibir comunicaciones promocionales por correo electrónico.")
                </label>
            </div>
            <div class="ag-field ag-field--full" style="flex-direction:row; align-items:flex-start; gap:8px;">
                <input type="checkbox" id="dlgMayoria" name="mayoria" value="si" required style="margin-top:4px;" />
                <label for="dlgMayoria" style="font-size:0.85rem; line-height:1.4;">
                    @TextoUi.T("Confirmo que soy mayor de 19 años o cuento con consentimiento de mi tutor legal.")
                </label>
            </div>
        </div>
        <button type="submit" class="ag-btn ag-auth-submit">@TextoUi.T("Registrarse")</button>
    </form>

    <p class="ag-login-alt">
        <button type="button" class="ag-link" @onclick="IrALogin">@TextoUi.T("¿Ya tienes cuenta? Inicia sesión")</button>
    </p>
</div>

@code {
    [Parameter]
    public string? Error { get; set; }

    private DateTime? fechaNacimiento;

    [Inject]
    private DialogService DialogService { get; set; } = default!;

    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;

    private void IrALogin()
    {
        DialogService.Close();
        NavigationManager.NavigateTo("/login");
    }
}
