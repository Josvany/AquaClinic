<div class="ag-login-dialog">
    <div class="ag-auth-shell">
        <section class="ag-auth-panel">
            <span class="ag-auth-marca">Aqua Skin &amp; Glow</span>

            <div class="ag-auth-head">
                <h1>@TextoUi.T("Crea tu cuenta")</h1>
                <p>@TextoUi.T("Regístrate y reserva tu primera cita en minutos.")</p>
            </div>

            @if (!string.IsNullOrEmpty(Error))
            {
                <div class="alert alert-danger">@TextoUi.T(Error)</div>
            }

            <form method="post" action="/auth/register">
                <AntiforgeryToken />
                <div class="ag-registro-grid">
                    <div class="ag-field">
                        <label for="dlgNombre">@TextoUi.T("Nombre")</label>
                        <input type="text" id="dlgNombre" name="nombre" class="login-field"
                               placeholder="@TextoUi.T("Tu nombre")" />
                    </div>
                    <div class="ag-field">
                        <label for="dlgApellidos">@TextoUi.T("Apellidos")</label>
                        <input type="text" id="dlgApellidos" name="apellidos" class="login-field"
                               placeholder="@TextoUi.T("Tus apellidos")" />
                    </div>
                    <div class="ag-field">
                        <label for="dlgEmail">@TextoUi.T("Correo")</label>
                        <input type="email" id="dlgEmail" name="email" class="login-field"
                               required placeholder="@TextoUi.T("tu@correo.com")" />
                    </div>
                    <div class="ag-field">
                        <label for="dlgTelefono">@TextoUi.T("Teléfono (opcional)")</label>
                        <input type="tel" id="dlgTelefono" name="telefono" class="login-field"
                               placeholder="@TextoUi.T("Tu teléfono")" />
                    </div>
                    <div class="ag-field">
                        <label for="dlgFechaNacimiento">@TextoUi.T("Fecha de nacimiento")</label>
                        <RadzenDatePicker @bind-Value="fechaNacimiento" DateFormat="dd/MM/yyyy" Style="width:100%;" Name="fechaNacimiento" />
                        <input type="hidden" name="fechaNacimiento" value="@(fechaNacimiento?.ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="ag-field">
                        <label for="dlgPassword">@TextoUi.T("Contraseña")</label>
                        <input type="password" id="dlgPassword" name="password" class="login-field"
                               required minlength="8" placeholder="@TextoUi.T("Mínimo 8 caracteres")" />
                    </div>
                    <div class="ag-field ag-field--full ag-field--check">
                        <input type="checkbox" id="dlgConsentimiento" name="consentimiento" value="si" />
                        <label for="dlgConsentimiento">
                            @TextoUi.T("Acepto recibir comunicaciones promocionales por correo electrónico.")
                        </label>
                    </div>
                    <div class="ag-field ag-field--full ag-field--check">
                        <input type="checkbox" id="dlgMayoria" name="mayoria" value="si" required />
                        <label for="dlgMayoria">
                            @TextoUi.T("Confirmo que soy mayor de 19 años o cuento con consentimiento de mi tutor legal.")
                        </label>
                    </div>
                </div>
                <button type="submit" class="ag-auth-submit">@TextoUi.T("Registrarse")</button>
            </form>

            <p class="ag-auth-alt">
                <button type="button" class="ag-link" @onclick="IrALogin">@TextoUi.T("¿Ya tienes cuenta? Inicia sesión")</button>
            </p>
        </section>

        <aside class="ag-auth-visual" aria-hidden="true">
            <img src="img/editorial-clinica.jpg" alt="" />
            <div class="ag-auth-visual-card ag-auth-visual-card--gold">
                <span class="ag-auth-visual-etiqueta">@TextoUi.T("Análisis digital de la piel")</span>
                <strong>@TextoUi.T("Tu primera visita")</strong>
                <span class="ag-auth-visual-meta">Langley, BC</span>
            </div>
            <div class="ag-auth-visual-card ag-auth-visual-card--light">
                <span class="ag-auth-visual-etiqueta">@TextoUi.T("Reserva en línea")</span>
                <strong>@TextoUi.T("Disponible 24/7")</strong>
                <span class="ag-auth-visual-meta">@TextoUi.T("Recordatorios por WhatsApp")</span>
            </div>
        </aside>
    </div>
</div>

@code {
    [Parameter]
    public string? Error { get; set; }

    private DateTime? fechaNacimiento;

    [Inject]
    private DialogService DialogService { get; set; } = default!;

    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;

    private void IrALogin()
    {
        DialogService.Close();
        DialogService.OpenAsync<LoginDialog>(
            TextoUi.T("Iniciar sesión"),
            new Dictionary<string, object?>(),
            new DialogOptions { Width = "70vw", Height = "auto", Resizable = false, Draggable = false });
    }
}
