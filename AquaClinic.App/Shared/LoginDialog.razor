<div class="ag-login-dialog">
    <span class="ag-saludo">Bienvenido de nuevo</span>

    <form method="post" action="/auth/login">
        <AntiforgeryToken />
        <div class="ag-field">
            <label for="dialogUserName">Correo</label>
            <input type="email" id="dialogUserName" name="email" required placeholder="tu@correo.com" />
        </div>
        <div class="ag-field">
            <label for="dialogPassword">Contrase&#241;a</label>
            <input type="password" id="dialogPassword" name="password" required minlength="8" />
        </div>
        <button type="submit">Iniciar sesi&oacute;n</button>
    </form>

    <p class="ag-login-alt">
        <button type="button" class="ag-link" @onclick="IrARegistro">&#191;No tienes cuenta? Reg&#237;strate</button>
    </p>
</div>

@code {
    [Inject]
    private DialogService DialogService { get; set; } = default!;

    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;

    private void IrARegistro()
    {
        DialogService.Close();
        NavigationManager.NavigateTo("/register");
    }
}
