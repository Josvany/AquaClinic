<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
            <NotAuthorized>
                <RedirectToLogin />
            </NotAuthorized>
        </AuthorizeRouteView>
    </Found>
    <NotFound>
        <PageTitle>@TextoUi.T("Página no encontrada")</PageTitle>
        <LayoutView Layout="typeof(MainLayout)">
            <p>@TextoUi.T("Lo sentimos, no hay nada en esta direccion.")</p>
        </LayoutView>
    </NotFound>
</Router>
